        <mxCell id="management-trigger-backup" value="触发指定后端" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#0066CC;fontColor=#0066CC;labelBackgroundColor=#FFFFFF;fontSize=12;exitX=0.37;exitY=1;entryX=0.5;entryY=0;" parent="1" source="backup-management" target="maintenance-trigger" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="990" y="1200" />
              <mxPoint x="1012" y="1200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="backup-completed" value="上传完成后返回备份结果" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#0066CC;fontColor=#0066CC;labelBackgroundColor=#FFFFFF;fontSize=12;exitX=0.5;exitY=1;entryX=0.82;entryY=1;" parent="1" source="snapshot" target="backup-management" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1825" y="1430" />
              <mxPoint x="780" y="1430" />
              <mxPoint x="780" y="1125" />
              <mxPoint x="1160" y="1125" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="storage-restore-a" value="A 启动：下载本后端快照并加载" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#CC6600;fontColor=#CC6600;labelBackgroundColor=#FFFFFF;fontSize=12;dashed=1;exitX=0;exitY=0.5;entryX=0.45;entryY=1;" parent="1" source="storage-icon" target="cache-a" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2240" y="1265" />
              <mxPoint x="2240" y="1160" />
              <mxPoint x="2030" y="1160" />
              <mxPoint x="2030" y="700" />
              <mxPoint x="1900" y="700" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="storage-restore-b" value="B 启动：下载本后端快照并加载" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#CC6600;fontColor=#CC6600;labelBackgroundColor=#FFFFFF;fontSize=12;dashed=1;exitX=1;exitY=0.5;entryX=0.53;entryY=1;" parent="1" source="storage-icon" target="cache-b" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2510" y="1265" />
              <mxPoint x="2510" y="700" />
              <mxPoint x="2300" y="700" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="lg-flow" value="蓝色 #0066CC：服务调用与结果返回（双向箭头表示请求 / 响应）　｜　橙色虚线 #CC6600：清理、备份与启动恢复&lt;br&gt;&lt;font color=&quot;#7B1FA2&quot;&gt;紫色字段：用于路由或模型选择，不作为业务筛选条件。&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="40" y="1550" width="2450" height="65" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="semantic-cache-api" name="接口签名">
    <mxGraphModel dx="1600" dy="1350" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1350" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="api-title" value="Vector Service 对外接口签名" style="text;html=1;align=left;fontSize=21;fontStyle=1;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="40" y="25" width="1520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="api-search" value="&lt;b&gt;POST /SemanticCache/Search&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#7B1FA2&quot;&gt;RoutingDeviceId: string&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7B1FA2&quot;&gt;Locale: string&lt;/font&gt;&lt;br&gt;Messages: [{ Role: string, Value: string }]&lt;br&gt;Customer: string; DeviceModel: string&lt;br&gt;Language: string; DeviceId: string&lt;br&gt;&lt;br&gt;&lt;b&gt;200 响应&lt;/b&gt;&lt;br&gt;{ Match: { OriginalQuestion: string,&lt;br&gt;  RewrittenQuestion: string, Answer: string,&lt;br&gt;  SimilarityScore: number } | null }&lt;br&gt;&lt;br&gt;固定 Top 1；不传 Answer / TTL / TopK。&lt;br&gt;四标签未传 / null / 空字符串 → 忽略对应条件。&lt;br&gt;返回匹配记录的问题和答案；由调用方决定使用。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontSize=15;fillColor=#E0F0FF;strokeColor=#0066CC;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="740" height="470" as="geometry" />
        </mxCell>
        <mxCell id="api-write" value="&lt;b&gt;POST /SemanticCache/Write&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#7B1FA2&quot;&gt;RoutingDeviceId: string&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#7B1FA2&quot;&gt;Locale: string&lt;/font&gt;&lt;br&gt;Messages: [{ Role: string, Value: string }]&lt;br&gt;Answer: string — 独立答案，不进入 Messages&lt;br&gt;TTL: integer — 单位分钟；未传用后台默认值&lt;br&gt;Customer: string; DeviceModel: string&lt;br&gt;Language: string; DeviceId: string&lt;br&gt;&lt;br&gt;&lt;b&gt;202 Accepted（建议无响应体）&lt;/b&gt;&lt;br&gt;仅表示已进入后台队列；并非最终写入成功。&lt;br&gt;后台仍须由 Vector Service 调用 Embeddings，&lt;br&gt;然后写入 Vector Service 已选择的缓存后端。&lt;br&gt;&lt;br&gt;无须先 Search；不要求未命中凭据。&lt;br&gt;TTL 建议只接受正整数，边界规则待定。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontSize=15;fillColor=#FFF8E1;strokeColor=#CC6600;" vertex="1" parent="1">
          <mxGeometry x="820" y="100" width="740" height="470" as="geometry" />
        </mxCell>
        <mxCell id="api-backup" value="&lt;b&gt;POST /SemanticCache/Backup（管理）&lt;/b&gt;&lt;br&gt;&lt;br&gt;BackendSlotIds: integer[] — 需要备份的后端编号&lt;br&gt;&lt;br&gt;&lt;b&gt;建议 202 响应&lt;/b&gt;&lt;br&gt;{ BackupId: string, Status: &amp;quot;Pending&amp;quot; }&lt;br&gt;&lt;br&gt;由 Vector Service 根据编号解析后端地址。&lt;br&gt;调用方不传后端 URL；不按设备身份选择单个后端。&lt;br&gt;接收任务不等于备份完成。&lt;br&gt;通过右侧状态接口查询，全部完成后才允许发布。&lt;br&gt;&lt;br&gt;独立管理授权；不调用 Embeddings。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontSize=15;fillColor=#F3E5F5;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="740" height="470" as="geometry" />
        </mxCell>
        <mxCell id="api-common" value="&lt;b&gt;公共契约&lt;/b&gt;：Messages 非空；每项 Role / Value 必填；最后一项 Role=user，Value 为当前问题，其余为历史；只有一条不改写。&lt;br&gt;&lt;b&gt;建议错误状态&lt;/b&gt;：400 参数错误；413 请求过大；429 写队列满；502 / 503 下游失败或服务不可用。错误不能包装成 Match=null。&lt;br&gt;&lt;b&gt;统一入口与路由&lt;/b&gt;：调用方只知道 Vector Service 地址；RoutingDeviceId 是路由输入，不是后端地址。后端池配置、HRW 计算与 A / B 分发全部在 Vector Service。" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=14;fontSize=15;fillColor=#F5F5F5;strokeColor=#999999;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="40" y="1120" width="1520" height="180" as="geometry" />
        </mxCell>
        <mxCell id="api-backup-status" parent="1" vertex="1" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=16;fontSize=15;fillColor=#F3E5F5;strokeColor=#9673A6;" value="&lt;b&gt;GET /SemanticCache/Backup/{BackupId}（管理）&lt;/b&gt;&lt;br&gt;路径参数 BackupId: string；无请求体&lt;br&gt;&lt;br&gt;&lt;b&gt;建议 200 响应&lt;/b&gt;&lt;br&gt;{ BackupId: string, Status: string,&lt;br&gt;  Backends: [{ BackendSlotId: integer,&lt;br&gt;    Status: string, SnapshotId: string,&lt;br&gt;    RecordCount: integer, Revision: string,&lt;br&gt;    CompletedAt: string, Error: string }] }&lt;br&gt;&lt;br&gt;Status = Pending / Running / Completed / Failed&lt;br&gt;CompletedAt 为 UTC 时间字符串。&lt;br&gt;所有指定后端成功，总体状态才为 Completed。&lt;br&gt;支持在不同 Vector Service 实例查询同一任务。&lt;br&gt;&lt;br&gt;独立管理授权；不调用 Embeddings。">
          <mxGeometry x="820" y="610" width="740" height="470" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

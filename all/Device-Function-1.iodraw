          <mxGeometry x="46" y="1071" width="248" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c-caller-title" value="&lt;b&gt;如网关的意图分类器&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;每句话检索一次&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" parent="c-caller" vertex="1">
          <mxGeometry x="12" y="8" width="226" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c-caller-body" value="请求带 Customer、DeviceId、&lt;br&gt;Language、问句&lt;br&gt;取前 3 名的 Answer（工具名）作为候选领域" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" parent="c-caller" vertex="1">
          <mxGeometry x="12" y="58" width="224" height="86" as="geometry" />
        </mxCell>
        <mxCell id="s-vs2" value="" style="rounded=1;arcSize=2;html=1;fillColor=#FEF5E7;strokeColor=#D97706;dashed=1;dashPattern=8 4;strokeWidth=1.5;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="720" y="1000" width="640" height="270" as="geometry" />
        </mxCell>
        <mxCell id="s-vs2-title" value="&lt;b&gt;向量服务  Assistant.Service.Vector · 检索&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#D97706;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="736" y="1010" width="608" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c-vsearch" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="736" y="1056" width="290" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c-vsearch-icon" value="" style="shape=image;html=1;image=img/lib/azure2/app_services/App_Services.svg;aspect=fixed;imageAspect=0;" parent="c-vsearch" vertex="1">
          <mxGeometry x="12" y="12" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c-vsearch-title" value="&lt;b&gt;/Vector/SearchSemanticSearch&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;现有接口&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" parent="c-vsearch" vertex="1">
          <mxGeometry x="56" y="8" width="224" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c-vsearch-body" value="问句 → embeddings App Service 算向量&lt;br&gt;按 customer + 语言查路由快照&lt;br&gt;多个地址时每次随机选一个&lt;br&gt;新增：把 Customer、DeviceId 传给站点&lt;br&gt;按阈值、TopK 过滤后返回" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" parent="c-vsearch" vertex="1">
          <mxGeometry x="12" y="58" width="266" height="116" as="geometry" />
        </mxCell>
        <mxCell id="s-site" value="" style="rounded=1;arcSize=2;html=1;fillColor=#F3EEFB;strokeColor=#7A4FC4;dashed=1;dashPattern=8 4;strokeWidth=1.5;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="1400" y="140" width="650" height="1130" as="geometry" />
        </mxCell>
        <mxCell id="s-site-title" value="&lt;b&gt;语义检索站点  ms-incarva-dev-vector-semanticsearch&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#7A4FC4;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1416" y="150" width="618" height="28" as="geometry" />
        </mxCell>
        <mxCell id="t-site" value="向量服务后面的 Python App Service 之一。单实例（gunicorn -w 1，一个进程一份内存）；部署成多个 App Service 时每个各一份，都要收到通知" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#6B21A8;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1416" y="176" width="618" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c-api" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A4FC4;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="1416" y="216" width="618" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c-api-icon" value="" style="shape=image;html=1;image=img/lib/azure2/app_services/App_Services.svg;aspect=fixed;imageAspect=0;" parent="c-api" vertex="1">
          <mxGeometry x="12" y="12" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c-api-title" value="&lt;b&gt;POST /semantic-search/device-tools/{customer}/{deviceId}&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;新增接口：某台车整组替换&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" parent="c-api" vertex="1">
          <mxGeometry x="56" y="8" width="552" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c-api-body" value="⑦ 查询②：只读这一台车的映射 + 工具行&lt;br&gt;⑧ 新出现的工具 Id：调 embedding 算向量&lt;br&gt;拿写锁加进 FAISS（本机实测：5000 条里删 20 个约 4 ms）&lt;br&gt;整体替换这台车的允许 Id 集合；同一请求发多次结果不变" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" parent="c-api" vertex="1">
          <mxGeometry x="12" y="58" width="594" height="86" as="geometry" />
        </mxCell>
        <mxCell id="c-faiss" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3EEFB;strokeColor=#7A4FC4;strokeWidth=2.5;" parent="1" vertex="1">
          <mxGeometry x="1416" y="392" width="618" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c-faiss-title" value="&lt;b&gt;内存：共用 FAISS 库&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;IndexIDMap2（IndexFlatIP）&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" parent="c-faiss" vertex="1">
          <mxGeometry x="12" y="8" width="596" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c-faiss-body" value="内置 27 个 + 所有车机工具，一个工具 Id 一份向量（同款车共用）&lt;br&gt;检索拿读锁，增删拿写锁（faiss：修改索引时必须互斥）&lt;br&gt;FAISS 的 Id 是整数：内存里维护“整数 ↔ 工具 Id”对照表" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" parent="c-faiss" vertex="1">
          <mxGeometry x="12" y="58" width="594" height="66" as="geometry" />
        </mxCell>
        <mxCell id="c-allow" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A4FC4;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="1416" y="548" width="618" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c-allow-title" value="&lt;b&gt;内存：车辆 → 允许的工具 Id&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" parent="c-allow" vertex="1">
          <mxGeometry x="12" y="8" width="596" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c-allow-body" value="(customer, deviceId) → 这台车映射里的工具 Id&lt;br&gt;来源：启动全量加载；之后由增删接口按车替换" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" parent="c-allow" vertex="1">
          <mxGeometry x="12" y="38" width="594" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c-start" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A4FC4;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="1416" y="853" width="618" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c-start-title" value="&lt;b&gt;启动  /  POST /semantic-search/refresh&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" parent="c-start" vertex="1">
          <mxGeometry x="12" y="8" width="596" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c-start-body" value="查询①（内置链路）+ 查询②（全部映射）全量加载，重建整个 FAISS 库&lt;br&gt;建完 /health 才返回 200；广播失败的站点靠人工 refresh 追上" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" parent="c-start" vertex="1">
          <mxGeometry x="12" y="38" width="594" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c-ssearch" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A4FC4;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="1416" y="1071" width="618" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c-ssearch-title" value="&lt;b&gt;POST /semantic-search/search&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;检索时不查库、不调 embedding&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" parent="c-ssearch" vertex="1">
          <mxGeometry x="12" y="8" width="596" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c-ssearch-body" value="允许集合 = 内置 27 个 Id ∪ 这台车映射的工具 Id&lt;br&gt;FAISS 按 Id 过滤检索（本机实测：5027 条里 1.4 ms，结果与逐个算内积一致）&lt;br&gt;不会混入别的车的工具；没注册过的车结果和现在一样&lt;br&gt;返回前 3 名：name、description、score、toolId" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" parent="c-ssearch" vertex="1">
          <mxGeometry x="12" y="58" width="594" height="86" as="geometry" />
        </mxCell>
        <mxCell id="s-ext" value="" style="rounded=1;arcSize=2;html=1;fillColor=#F5F6F8;strokeColor=#6B7280;dashed=1;dashPattern=8 4;strokeWidth=1.5;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="2090" y="140" width="290" height="260" as="geometry" />
        </mxCell>
        <mxCell id="s-ext-title" value="&lt;b&gt;外部模型&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#6B7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="2106" y="150" width="258" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c-emb" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="2106" y="186" width="258" height="190" as="geometry" />
        </mxCell>
        <mxCell id="c-emb-icon" value="" style="shape=image;html=1;image=img/lib/azure2/ai_machine_learning/Azure_OpenAI.svg;aspect=fixed;imageAspect=0;" parent="c-emb" vertex="1">
          <mxGeometry x="12" y="12" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c-emb-title" value="&lt;b&gt;Azure OpenAI embedding&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;text-embedding-3-large&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" parent="c-emb" vertex="1">
          <mxGeometry x="56" y="8" width="192" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c-emb-body" value="站点只给新出现的车机工具&lt;br&gt;描述算向量&lt;br&gt;同一段描述只算一次&lt;br&gt;问句向量由 embeddings&lt;br&gt;App Service 算" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" parent="c-emb" vertex="1">
          <mxGeometry x="12" y="58" width="234" height="126" as="geometry" />
        </mxCell>
        <mxCell id="n-writes" value="&lt;b&gt;注册时每种变化写几张表&lt;/b&gt;&lt;br&gt;新增，库里已有同名同描述的工具：&lt;br&gt;　映射表 1 张&lt;br&gt;新增，库里还没有：&lt;br&gt;　函数行 + 工具行 + 映射 3 张&lt;br&gt;删除：映射软删除 1 张&lt;br&gt;改描述 / 改名：旧映射软删 + 按新增，1～3 张&lt;br&gt;只改参数结构：不写（按名字 + 描述仍是同一个）&lt;br&gt;没变化：不写&lt;br&gt;模型、分组、代理、模板、参数表：都不碰" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#CCCCCC;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="2090" y="430" width="290" height="280" as="geometry" />
        </mxCell>
        <mxCell id="n-multi" value="&lt;b&gt;部署多个 App Service 时&lt;/b&gt;&lt;br&gt;路由表同一条路由配多个地址：AppCount=N，PoolMember 写 N 行（SlotIndex 1..N），两处改动放一个事务。&lt;br&gt;检索每次随机选一个地址，所以车机工具的通知必须发给每个地址。&lt;br&gt;路由表只在向量服务启动时读一次，改完要重启向量服务。" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#CCCCCC;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="2090" y="740" width="290" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n-platform" value="&lt;b&gt;向量平台的组成&lt;/b&gt;&lt;br&gt;向量服务 Assistant.Service.Vector（C#）：对外接口、路由、读写配置库、广播。&lt;br&gt;后面的 Python App Service：embeddings（改写 + 向量化）、bymodel（车书 / QnA）、bydevice（设备记忆）、semanticcache（语义缓存）、semanticsearch（语义检索，本图）。&lt;br&gt;设备网关、对话网关只调向量服务的接口。" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#CCCCCC;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="2090" y="1000" width="290" height="270" as="geometry" />
        </mxCell>
        <mxCell id="e-r1" value="① 上报" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#1D6FD8;fontColor=#1D6FD8;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="c-car" target="c-dg" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-r2" value="② 转发" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#1D6FD8;fontColor=#1D6FD8;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.303;entryDx=0;entryDy=0;" parent="1" source="c-dg" target="c-reg" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-r3" value="③ 写函数行+工具行" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#1D6FD8;fontColor=#1D6FD8;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" parent="1" source="c-reg" target="c-tool" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="794" y="610" />
              <mxPoint x="466" y="610" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-r4" value="③ 新增 / 软删映射" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#1D6FD8;fontColor=#1D6FD8;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.569;entryY=0;entryDx=0;entryDy=0;" parent="1" source="c-reg" target="c-map" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-b1" value="④ 广播" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#D97706;fontColor=#D97706;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.303;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="c-reg" target="c-bc" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-b2" value="⑤ 取全部地址" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#D97706;fontColor=#D97706;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="c-bc" target="c-route" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-b3" value="⑥ 通知" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#D97706;fontColor=#D97706;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" parent="1" source="c-bc" target="c-api" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-g1" value="⑦ 读这台车" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#1E8E5A;fontColor=#1E8E5A;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" parent="1" source="c-map" target="c-api" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1380" y="724" />
              <mxPoint x="1380" y="336" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-g2" value="启动加载" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#1E8E5A;fontColor=#1E8E5A;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="c-builtin" target="c-start" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-ref1" value="FunctionId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#1E8E5A;fontColor=#1E8E5A;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="c-tool" target="c-func" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-ref2" value="工具 Id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#1E8E5A;fontColor=#1E8E5A;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0;exitY=0.53;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="c-map" target="c-tool" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-x1" value="⑧ 算向量" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#6B7280;fontColor=#6B7280;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.474;entryDx=0;entryDy=0;" parent="1" source="c-api" target="c-emb" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-p0" value="加向量（写锁）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#7A4FC4;fontColor=#7A4FC4;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" parent="1" source="c-api" target="c-faiss" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-s1" value="Ⓐ 每句话检索" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#7A4FC4;fontColor=#7A4FC4;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="c-caller" target="c-vsearch" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-s2" value="Ⓑ 随机选一个站点" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#7A4FC4;fontColor=#7A4FC4;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="c-vsearch" target="c-ssearch" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lg-box" value="" style="rounded=1;arcSize=12;html=1;fillColor=#FAFAFA;strokeColor=#CCCCCC;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="30" y="1300" width="1185.28" height="44" as="geometry" />
        </mxCell>
        <mxCell id="lg-title" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="46" y="1300" width="50" height="44" as="geometry" />
        </mxCell>
        <mxCell id="lg-s0" value="" style="line;html=1;strokeWidth=2;strokeColor=#1D6FD8;" parent="1" vertex="1">

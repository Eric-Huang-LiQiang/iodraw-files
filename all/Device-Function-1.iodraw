<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) ioDraw.com/3.6.1 Chrome/124.0.6367.49 Electron/30.0.0 Safari/537.36" version="24.7.17">
  <diagram id="device-tools" name="车机Function注册与检索">
    <mxGraphModel dx="1693" dy="1029" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2410" pageHeight="1420" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;车机 Function 注册并参与语义检索比对（设计稿 v2）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=24;fontColor=#1F2937;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="30" y="18" width="1800" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="设备网关只鉴权并转发；向量服务比对后把车机工具写进现有工具表，用映射表按 customer + deviceId 限定，再广播到各语义检索站点。站点里车机工具和内置 27 个工具共用一个 FAISS 库，检索时按 Id 过滤。" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#4B5563;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="30" y="56" width="2340" height="24" as="geometry" />
        </mxCell>
        <mxCell id="steps" value="&lt;b&gt;&lt;font color=&#39;#1D6FD8&#39;&gt;注册同步&lt;/font&gt;&lt;/b&gt;：① 车机上报全量 MCP → ② 设备网关鉴权后转发 → ③ 向量服务比对、一个事务写库 → ④ 提交后广播 → ⑤ 取全部站点地址 → ⑥ 逐个通知站点 → ⑦ 站点读这台车的映射 → ⑧ 新工具算向量　　&lt;b&gt;&lt;font color=&#39;#7A4FC4&#39;&gt;检索&lt;/font&gt;&lt;/b&gt;：Ⓐ 调用方请求向量服务 → Ⓑ 随机选一个站点，按 Id 过滤检索" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#374151;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="30" y="84" width="2340" height="24" as="geometry" />
        </mxCell>
        <mxCell id="s-car" value="" style="rounded=1;arcSize=2;html=1;fillColor=#F5F6F8;strokeColor=#6B7280;dashed=1;dashPattern=8 4;strokeWidth=1.5;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="30" y="140" width="280" height="450" as="geometry" />
        </mxCell>
        <mxCell id="s-car-title" value="&lt;b&gt;车机&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#6B7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="46" y="150" width="248" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c-car" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="46" y="186" width="248" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c-car-title" value="&lt;b&gt;车机&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;MCP 命令组暴露的工具&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" parent="c-car" vertex="1">
          <mxGeometry x="12" y="8" width="226" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c-car-body" value="启动时 registerTools 上报全量&lt;br&gt;请求体：MCP 工具 JSON 字符串数组&lt;br&gt;请求头：api-key、customer、&lt;br&gt;DeviceId、DeviceModel、UserId&lt;br&gt;运行中增删 MCP：要再上报一次&lt;br&gt;（车机侧是否改，待定）" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" parent="c-car" vertex="1">
          <mxGeometry x="12" y="58" width="224" height="136" as="geometry" />
        </mxCell>
        <mxCell id="s-dg" value="" style="rounded=1;arcSize=2;html=1;fillColor=#F5F6F8;strokeColor=#6B7280;dashed=1;dashPattern=8 4;strokeWidth=1.5;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="350" y="140" width="330" height="450" as="geometry" />
        </mxCell>
        <mxCell id="s-dg-title" value="&lt;b&gt;设备网关  Assistant.DeviceGateway&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#6B7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="366" y="150" width="298" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c-dg" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="366" y="186" width="298" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c-dg-icon" value="" style="shape=image;html=1;image=img/lib/azure2/app_services/App_Services.svg;aspect=fixed;imageAspect=0;" parent="c-dg" vertex="1">
          <mxGeometry x="12" y="12" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c-dg-title" value="&lt;b&gt;POST /Device/RegisterTools&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;新增接口，只做鉴权和转发&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" parent="c-dg" vertex="1">
          <mxGeometry x="56" y="8" width="232" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c-dg-body" value="ApiKey 中间件：解密后须等于 DeviceId&lt;br&gt;请求头 customer、DeviceId、DeviceModel&lt;br&gt;+ 工具数组 → 向量服务的请求体&lt;br&gt;不碰配置库，不含任何向量逻辑" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" parent="c-dg" vertex="1">
          <mxGeometry x="12" y="58" width="274" height="136" as="geometry" />
        </mxCell>
        <mxCell id="s-vs1" value="" style="rounded=1;arcSize=2;html=1;fillColor=#FEF5E7;strokeColor=#D97706;dashed=1;dashPattern=8 4;strokeWidth=1.5;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="720" y="140" width="640" height="450" as="geometry" />
        </mxCell>
        <mxCell id="s-vs1-title" value="&lt;b&gt;向量服务  Assistant.Service.Vector · 注册与广播&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#D97706;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="736" y="150" width="608" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c-reg" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="736" y="186" width="290" height="330" as="geometry" />
        </mxCell>
        <mxCell id="c-reg-icon" value="" style="shape=image;html=1;image=img/lib/azure2/app_services/App_Services.svg;aspect=fixed;imageAspect=0;" parent="c-reg" vertex="1">
          <mxGeometry x="12" y="12" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c-reg-title" value="&lt;b&gt;POST /Vector/RegisterDeviceTools&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;新增接口，注册逻辑全在这里&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" parent="c-reg" vertex="1">
          <mxGeometry x="56" y="8" width="224" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c-reg-body" value="customer 统一 Trim + 小写&lt;br&gt;工具行按“名字 + 描述”查找（带锁）：&lt;br&gt;　有就复用，没有就新建函数行 + 工具行&lt;br&gt;和这台车当前的映射逐个比较：&lt;br&gt;　新增 → 加映射&lt;br&gt;　删除 → 软删除映射&lt;br&gt;　改描述 / 改名 → 旧映射软删 + 按新增&lt;br&gt;工具行、函数行不删、不原地改&lt;br&gt;一个事务提交；提交后后台广播，&lt;br&gt;不阻塞给车机的返回" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" parent="c-reg" vertex="1">
          <mxGeometry x="12" y="58" width="266" height="266" as="geometry" />
        </mxCell>
        <mxCell id="c-bc" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="1086" y="186" width="258" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c-bc-title" value="&lt;b&gt;车机工具广播&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;写库提交后，后台执行&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" parent="c-bc" vertex="1">
          <mxGeometry x="12" y="8" width="236" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c-bc-body" value="从路由快照取所有语义检索地址并去重&lt;br&gt;（不分 customer、语言：站点存全部车）&lt;br&gt;逐个调站点的增删接口&lt;br&gt;失败重试几次，仍失败记错误日志&lt;br&gt;补救：人工调站点 /refresh" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" parent="c-bc" vertex="1">
          <mxGeometry x="12" y="58" width="234" height="136" as="geometry" />
        </mxCell>
        <mxCell id="c-route" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="1086" y="406" width="258" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c-route-title" value="&lt;b&gt;路由快照（内存）&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;来自配置库两张路由表&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" parent="c-route" vertex="1">
          <mxGeometry x="12" y="8" width="236" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c-route-body" value="Mapping + PoolMember，启动时读一次&lt;br&gt;多地址：AppCount=N + N 行" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" parent="c-route" vertex="1">
          <mxGeometry x="12" y="58" width="234" height="46" as="geometry" />
        </mxCell>
        <mxCell id="s-db" value="" style="rounded=1;arcSize=2;html=1;fillColor=#EAF6EF;strokeColor=#1E8E5A;dashed=1;dashPattern=8 4;strokeWidth=1.5;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="30" y="630" width="1330" height="330" as="geometry" />
        </mxCell>
        <mxCell id="s-db-title" value="&lt;b&gt;配置库  ms-incarva-dev-v3-gateway&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#1E8E5A;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="46" y="640" width="1298" height="28" as="geometry" />
        </mxCell>
        <mxCell id="n-tpl" value="&lt;b&gt;车机工具为什么不挂模板&lt;/b&gt;&lt;br&gt;PromptTemplateId 留空。挂到 LLM 代理的模板下会：&lt;br&gt;① 所有车的工具进同一份库，互相看得见&lt;br&gt;② LLM 组装工具时（GetFunctions）懒加载模板下全部工具，每次对话都带上所有车的工具&lt;br&gt;③ 模型发布时整棵复制，车机工具跟着复制&lt;br&gt;所以车机工具不走内置链路，走映射表（查询②）" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#CCCCCC;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="46" y="676" width="270" height="270" as="geometry" />
        </mxCell>
        <mxCell id="c-tool" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E8E5A;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="346" y="676" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="c-tool-title" value="&lt;b&gt;[LLM].[PromptMessageTool]&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;工具行，和内置工具同一张表&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" parent="c-tool" vertex="1">
          <mxGeometry x="12" y="8" width="278" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c-tool-body" value="Name、Description = MCP 原文&lt;br&gt;Type=function，EType=2705，ExternalApi=0&lt;br&gt;PromptTemplateId = 空&lt;br&gt;Value = 原始 MCP JSON；FunctionId → 函数行&lt;br&gt;名字 + 描述相同的车共用一行" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" parent="c-tool" vertex="1">
          <mxGeometry x="12" y="58" width="276" height="106" as="geometry" />
        </mxCell>
        <mxCell id="c-func" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E8E5A;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="346" y="866" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c-func-title" value="&lt;b&gt;[LLM].[PromptMessageToolFunction]&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" parent="c-func" vertex="1">
          <mxGeometry x="12" y="8" width="278" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c-func-body" value="函数行：EType=2706，名字、描述同工具行&lt;br&gt;ParameterId 空（不拆参数表），Domain=&#39;&#39;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" parent="c-func" vertex="1">
          <mxGeometry x="12" y="38" width="276" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c-map" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF6EF;strokeColor=#1E8E5A;strokeWidth=2.5;" parent="1" vertex="1">
          <mxGeometry x="760" y="676" width="274" height="160" as="geometry" />
        </mxCell>
        <mxCell id="c-map-title" value="&lt;b&gt;[Device].[DeviceToolMapping]&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;映射表（新建）&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" parent="c-map" vertex="1">
          <mxGeometry x="12" y="8" width="252" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c-map-body" value="Customer（小写）、DeviceId、DeviceModel&lt;br&gt;PromptMessageToolId → 工具行&lt;br&gt;唯一：(Customer, DeviceId, 工具 Id)&lt;br&gt;删除 = 软删除 Deleted=1&lt;br&gt;同一工具加回来时恢复原行" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" parent="c-map" vertex="1">
          <mxGeometry x="12" y="58" width="250" height="96" as="geometry" />
        </mxCell>
        <mxCell id="c-builtin" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E8E5A;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="1086" y="850" width="258" height="96" as="geometry" />
        </mxCell>
        <mxCell id="c-builtin-title" value="&lt;b&gt;内置 27 个工具的链路（不变）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" parent="c-builtin" vertex="1">
          <mxGeometry x="12" y="8" width="236" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c-builtin-body" value="模型 → 分组 → 代理 LLM → 模板&lt;br&gt;→ 工具行（挂在模板上）" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" parent="c-builtin" vertex="1">
          <mxGeometry x="12" y="38" width="234" height="52" as="geometry" />
        </mxCell>
        <mxCell id="s-caller" value="" style="rounded=1;arcSize=2;html=1;fillColor=#F5F6F8;strokeColor=#6B7280;dashed=1;dashPattern=8 4;strokeWidth=1.5;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="30" y="1000" width="280" height="270" as="geometry" />
        </mxCell>
        <mxCell id="s-caller-title" value="&lt;b&gt;调用方&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#6B7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="46" y="1010" width="248" height="28" as="geometry" />

<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) ioDraw.com/3.6.1 Chrome/124.0.6367.49 Electron/30.0.0 Safari/537.36" version="24.7.17">
  <diagram id="flow" name="注册与匹配">
    <mxGraphModel dx="2257" dy="1372" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="3420" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;车机 Function：注册时怎么更新数据库和向量库，匹配时怎么筛选比对范围&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=28;fontColor=#111827;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="30" y="14" width="2440" height="40" as="geometry" />
        </mxCell>
        <mxCell id="h1" value="&lt;b&gt;一、注册：车机提交全量 MCP 后，数据库和向量库怎么更新&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=22;fontColor=#1D6FD8;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="30" y="64" width="2440" height="32" as="geometry" />
        </mxCell>
        <mxCell id="h1s" value="以 function name 为依据，和这台车的有效 mapping 逐个比较；③ ~ ⑦ 在同一个数据库事务里。提交后调站点实时更新这个 语言 + 车企 + 车型 的向量库，站点后台整库上传 Blob。SQL 是唯一可信数据。" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#4B5563;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="30" y="100" width="2440" height="26" as="geometry" />
        </mxCell>
        <mxCell id="lane-a" value="" style="rounded=1;arcSize=2;html=1;fillColor=#EDF4FD;strokeColor=#1D6FD8;dashed=1;dashPattern=8 4;strokeWidth=1.5;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="30" y="140" width="1680" height="2110" as="geometry" />
        </mxCell>
        <mxCell id="lane-a-title" value="&lt;b&gt;车机 → 设备网关 → 向量服务：比对并写数据库&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#1D6FD8;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="46" y="150" width="1648" height="28" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="① 车机提交全量 MCP&lt;br&gt;请求头：customer、DeviceId、DeviceModel、Language" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#6B7280;strokeWidth=1.5;fontSize=15;fontColor=#111827;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="590" y="190" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="② 设备网关：api-key 鉴权后，转发向量服务" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#6B7280;strokeWidth=1.5;fontSize=15;fontColor=#111827;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="640" y="290" width="460" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="车企、车型、语言&lt;br&gt;是否不为空？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B45309;strokeWidth=1.5;fontSize=15;fontColor=#111827;spacing=2;" parent="1" vertex="1">
          <mxGeometry x="700" y="380" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n3e" value="返回 400" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF3F2;strokeColor=#B42318;strokeWidth=1.5;fontSize=15;fontColor=#111827;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="1100" y="415" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="③ 开事务；解析 MCP：不合格的跳过，&lt;br&gt;记入 skipped；同一请求里同名的只留第一个" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6FD8;strokeWidth=1.5;fontSize=15;fontColor=#111827;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="640" y="530" width="460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="④ 读这台车的有效 mapping（未删除的），&lt;br&gt;连工具行取 function name" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6FD8;strokeWidth=1.5;fontSize=15;fontColor=#111827;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="640" y="630" width="460" height="70" as="geometry" />
        </mxCell>
        <mxCell id="na1" value="&lt;b&gt;mapping 和“同一个”&lt;/b&gt;&lt;br&gt;mapping：映射表 [Device].[DeviceToolMapping] 的一行，表示这台车用哪一行工具；软删除的不算有效。&lt;br&gt;function name：忽略大小写（配置库排序规则不区分大小写）。&lt;br&gt;描述：严格比较，大小写、空格不同都算不同。&lt;br&gt;复用只在同车企 + 车型 + 语言里找，不同车企、车型、语言不共用一行。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#CCCCCC;fontSize=14;fontColor=#333333;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="70" y="190" width="480" height="200" as="geometry" />
        </mxCell>
        <mxCell id="na2" value="&lt;b&gt;注册全程不碰&lt;/b&gt;&lt;br&gt;通用 function（挂在 LLM 代理模板下的 27 行）：不改、不删，不参与按 function name 比较。&lt;br&gt;工具行只会新建或就地更新，注册流程不删工具行。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#CCCCCC;fontSize=14;fontColor=#333333;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="1270" y="190" width="420" height="130" as="geometry" />
        </mxCell>

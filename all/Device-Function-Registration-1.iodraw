              <mxPoint x="2305" y="1150" />
              <mxPoint x="1960" y="1150" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="g11" value="后台" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#374151;fontColor=#374151;strokeWidth=2;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2794;entryY=0;entryDx=0;entryDy=0;" parent="1" source="s5" target="s6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nb1" value="&lt;b&gt;失败了怎么办&lt;/b&gt;&lt;br&gt;SQL 是唯一可信数据：调站点失败、上传 Blob 失败都不丢数据。&lt;br&gt;站点重启时从 Blob 下载库，再和 SQL 比对：缺的、Updated 对不上的重算，不再被引用的删掉。&lt;br&gt;检索时发现缺向量或 Updated 对不上，也会当场补算（见下面匹配 Ⓓ 之后）。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#CCCCCC;fontSize=14;fontColor=#333333;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="1770" y="1420" width="680" height="140" as="geometry" />
        </mxCell>
        <mxCell id="nb2" value="&lt;b&gt;向量什么时候变（没有过期时间）&lt;/b&gt;&lt;br&gt;新注册：新建的行算一条加入；复用的行库里已有就不动&lt;br&gt;描述就地更新：重算这一条，替换旧的&lt;br&gt;库里不再有车引用：删掉这一条&lt;br&gt;通用 function 描述改了：/refresh 或站点重启时重算&lt;br&gt;换 embedding 模型：整库重算" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#CCCCCC;fontSize=14;fontColor=#333333;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="1770" y="1590" width="680" height="160" as="geometry" />
        </mxCell>
        <mxCell id="h2" value="&lt;b&gt;二、匹配：一句话进来，哪些 function 参与比对&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=22;fontColor=#7A4FC4;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="30" y="2290" width="2440" height="32" as="geometry" />
        </mxCell>
        <mxCell id="h2s" value="先按 语言 + 车企 + 车型 选库，再查这台车的注册得到集合 R；通用 function 去掉被这台车同名覆盖的，和 R 合起来就是比对范围。检索时不算描述向量（除非补缺），也不在内存里缓存“车辆 → 工具”。" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#4B5563;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="30" y="2326" width="2440" height="26" as="geometry" />
        </mxCell>
        <mxCell id="lane-c" value="" style="rounded=1;arcSize=2;html=1;fillColor=#EDF4FD;strokeColor=#1D6FD8;dashed=1;dashPattern=8 4;strokeWidth=1.5;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="30" y="2370" width="620" height="960" as="geometry" />
        </mxCell>
        <mxCell id="lane-c-title" value="&lt;b&gt;调用方 → 向量服务&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#1D6FD8;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="46" y="2380" width="588" height="28" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="调用方（如网关的意图分类器）&lt;br&gt;Customer、DeviceModel、DeviceId、&lt;br&gt;Language、问句" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#6B7280;strokeWidth=1.5;fontSize=15;fontColor=#111827;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="40" y="2420" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="车型是否&lt;br&gt;不为空？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B45309;strokeWidth=1.5;fontSize=15;fontColor=#111827;spacing=2;" parent="1" vertex="1">

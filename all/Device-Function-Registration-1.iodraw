        <mxCell id="k3b" value="补缺：只为缺的、Updated 对不上的&lt;br&gt;算向量，写锁加入或替换，排一次上传" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F4EA;strokeColor=#7A4FC4;strokeWidth=1.5;fontSize=15;fontColor=#111827;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">

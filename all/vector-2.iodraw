        </mxCell>
        <mxCell id="lg1" value="━━ 深灰实线 主链路（Client → Gateway；Gateway ↔ 改写服务）　　━━ 蓝实线 只读检索（车书/QA，轮询）" style="text;html=1;fontSize=11;align=left;fontColor=#333333;" parent="1" vertex="1">
          <mxGeometry x="270" y="1362" width="860" height="18" as="geometry" />
        </mxCell>
        <mxCell id="lg2" value="- - ○ 洋红虚线 语义缓存（与车书/QA、长尾偏好并列；bymodel-cache 走轮询、bydevice-cache 走 HRW+Affinity）(#c2185b)" style="text;html=1;fontSize=11;align=left;fontColor=#C2185B;" parent="1" vertex="1">

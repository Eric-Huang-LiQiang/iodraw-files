        </mxCell>
        <mxCell id="lg4" value="- - 绿/橙虚线 离线 pipeline 产出 → Blob（车书/QnA 建库产出；记忆提炼偏好写回）(#2e7d32)" style="text;html=1;fontSize=11;align=left;fontColor=#2E7D32;" parent="1" vertex="1">
          <mxGeometry x="270" y="1428" width="860" height="18" as="geometry" />
        </mxCell>
        <mxCell id="pl-box" value="" style="rounded=1;fillColor=#ECEFF1;opacity=70;dashed=1;dashPattern=8 8;strokeColor=#546E7A;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="250" y="1500" width="1190" height="240" as="geometry" />
        </mxCell>
        <mxCell id="pl-icon" value="" style="shape=image;image=img/lib/azure2/devops/Azure_DevOps.svg;aspect=fixed;imageWidth=28;imageHeight=28;" parent="1" vertex="1">
          <mxGeometry x="268" y="1512" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="pl-hdr" value="&lt;b&gt;离线数据生产层 · Azure DevOps Pipeline&lt;/b&gt;（批处理，非实时；产出经 Blob 中转，被上方检索目标消费）" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#37474F;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="304" y="1512" width="900" height="28" as="geometry" />
        </mxCell>
        <mxCell id="pl-carbook" value="&lt;b&gt;车书向量库生成&lt;/b&gt;&#xa;Document Intelligence → 切块 → 嵌入 → 建 UserManual 索引" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=11;fontColor=#0D47A1;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="272" y="1560" width="272" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pl-carbook-tag" value="Azure DevOps Pipeline" style="text;html=1;fontSize=9.5;align=left;fontColor=#607D8B;" parent="1" vertex="1">
          <mxGeometry x="280" y="1626" width="200" height="16" as="geometry" />
        </mxCell>
        <mxCell id="pl-qna" value="&lt;b&gt;QnA 向量库生成&lt;/b&gt;&#xa;问答对 → 切块 → 嵌入 → 建 QnA 索引" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=11;fontColor=#0D47A1;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="564" y="1560" width="272" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pl-qna-tag" value="Azure DevOps Pipeline" style="text;html=1;fontSize=9.5;align=left;fontColor=#607D8B;" parent="1" vertex="1">
          <mxGeometry x="572" y="1626" width="200" height="16" as="geometry" />
        </mxCell>
        <mxCell id="pl-memory" value="&lt;b&gt;记忆提炼&lt;/b&gt;&#xa;对话历史 → 提炼长尾偏好 → 嵌入 → 写长尾偏好库" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CC6600;fontSize=11;fontColor=#BF360C;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="856" y="1560" width="272" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pl-memory-tag" value="Azure DevOps Pipeline" style="text;html=1;fontSize=9.5;align=left;fontColor=#607D8B;" parent="1" vertex="1">
          <mxGeometry x="864" y="1626" width="200" height="16" as="geometry" />
        </mxCell>
        <mxCell id="pl-cleanup-tag" value="Azure DevOps Pipeline · 定时触发" style="text;html=1;fontSize=9.5;align=left;fontColor=#607D8B;" parent="1" vertex="1">
          <mxGeometry x="1156" y="1626" width="240" height="16" as="geometry" />
        </mxCell>
        <mxCell id="pl-desc" value="四个 pipeline 都是离线批处理：车书/QnA 生成 = 建只读库产出 → Blob → ByModel 只读同步；记忆提炼 = 从对话提炼偏好 → 经 Blob → ByDevice 长尾偏好库；缓存过期清理 = 定时物理删除过期缓存条目（底层向量库无原生 TTL）。运行时服务只消费，不建库。" style="text;html=1;fontSize=10;fillColor=#F5F5F5;strokeColor=#B0BEC5;rounded=1;align=left;spacingLeft=8;spacingTop=4;whiteSpace=wrap;fontColor=#455A64;" parent="1" vertex="1">
          <mxGeometry x="272" y="1660" width="1148" height="60" as="geometry" />
        </mxCell>

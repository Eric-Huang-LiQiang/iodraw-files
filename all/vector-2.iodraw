        <mxCell id="p13" value="Python遍历O(N)&lt;br&gt;metadata_filter" style="rounded=0;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontColor=#263238;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="640" y="988" width="380" height="62" as="geometry" />
        </mxCell>
        <mxCell id="lg-legend" value="图例：  🟢 绿=占优 / 更省 / 更简单     🟡 黄=中等 / 有条件     🔴 红=劣势 / 需自研 / 有风险" style="rounded=1;html=1;fillColor=#F5F5F5;strokeColor=#BDBDBD;fontColor=#424242;fontSize=11;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="40" y="1070" width="980" height="30" as="geometry" />
        </mxCell>
        <mxCell id="concl" value="&lt;b&gt;结论（基于实测）&lt;/b&gt;&lt;br&gt;• &lt;b&gt;性能不是分水岭&lt;/b&gt;：端到端都被嵌入(~150-230ms)与网络主导，纯检索差异(41ms vs 8ms)在端到端里被淹没。&lt;br&gt;• &lt;b&gt;选 AI Search 的理由是运维/一致性/准确性，不是速度&lt;/b&gt;：删掉三级缓存+blob同步、根治并发写覆盖、Hit@5略优(1.0 vs 0.98)。&lt;br&gt;• &lt;b&gt;选 Python 自研的理由是跨云/成本/无锁定&lt;/b&gt;：可搬任意云或离线、近零边际成本、开源无厂商锁定。&lt;br&gt;• &lt;b&gt;务实路线&lt;/b&gt;：只读小库(车书/QA)留 FAISS 省成本；多租户可写库(长尾偏好)迁 AI Search 换一致性托管。" style="rounded=1;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontColor=#263238;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="40" y="1114" width="980" height="128" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

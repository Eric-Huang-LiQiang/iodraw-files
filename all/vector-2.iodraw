        </mxCell>
        <mxCell id="lg3" value="━━ 橙实线 有状态检索（长尾偏好，HRW → Affinity）　　- - 蓝灰虚线 Blob 同步/写回灌/恢复(#6c8ebf)" style="text;html=1;fontSize=11;align=left;fontColor=#CC6600;" parent="1" vertex="1">

          <mxGeometry x="268" y="112" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="gw-hdr" value="&lt;b&gt;Vector Gateway&lt;/b&gt;　查询/更新统一入口 · 编排层（无状态，可横向扩）" style="text;html=1;fontSize=13.5;fontStyle=1;fontColor=#4527A0;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="300" y="112" width="604" height="28" as="geometry" />
        </mxCell>
        <mxCell id="gw-entry" value="①　统一入口&#xa;/vector　query + update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E57C2;fontSize=12;fontColor=#311B92;" parent="1" vertex="1">
          <mxGeometry x="280" y="158" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gw-rw" value="②　调改写服务&#xa;→ 改写后 query" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E57C2;fontSize=12;fontColor=#311B92;" parent="1" vertex="1">
          <mxGeometry x="510" y="158" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gw-embed" value="③　向量化&#xa;→ query 向量 q" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E57C2;fontSize=12;fontColor=#311B92;" parent="1" vertex="1">
          <mxGeometry x="720" y="158" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gw-route" value="④　按 type 路由到检索目标&#xa;（透传 q，后端不再 embed）&#xa;车书/QA｜长尾偏好｜语义缓存 三类并列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E57C2;fontSize=12;fontColor=#311B92;" parent="1" vertex="1">
          <mxGeometry x="930" y="158" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gw-hrw" value="&lt;b&gt;HRW&lt;/b&gt;　key=deviceId · N 选一（抖动 1/N）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#CC6600;fontSize=11;fontColor=#BF360C;" parent="1" vertex="1">
          <mxGeometry x="1190" y="158" width="220" height="28" as="geometry" />
        </mxCell>
        <mxCell id="gw-aff" value="&lt;b&gt;Session Affinity&lt;/b&gt;　钉 deviceId 到固定 instance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#CC6600;fontSize=11;fontColor=#BF360C;" parent="1" vertex="1">
          <mxGeometry x="1190" y="190" width="220" height="28" as="geometry" />
        </mxCell>
        <mxCell id="gw-note" value="只读库（车书/QA）与 bymodel-cache 按车型共享、任意副本轮询，不走 HRW。长尾偏好与 bydevice-cache 都按 deviceId 走 HRW + Session Affinity 落固定 instance。语义缓存是与车书/QA、长尾偏好并列的一类检索目标 —— 命中与否不改变其它目标的调用（不是前置短路）。" style="text;html=1;fontSize=10.5;fillColor=#F3E5F5;strokeColor=#CE93D8;rounded=1;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;fontColor=#6A1B9A;" parent="1" vertex="1">
          <mxGeometry x="280" y="240" width="1130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rw-box" value="" style="rounded=1;fillColor=#E8F5E9;opacity=60;dashed=1;dashPattern=6 6;strokeColor=#2E7D32;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="260" y="430" width="680" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rw-svc-icon" value="" style="shape=image;image=img/lib/azure2/app_services/App_Services.svg;aspect=fixed;imageWidth=28;imageHeight=28;" parent="1" vertex="1">
          <mxGeometry x="277" y="441" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="rw-hdr" value="&lt;b&gt;改写服务 App Service&lt;/b&gt;（无状态 · 可横向扩）" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#1B5E20;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="312" y="442" width="400" height="26" as="geometry" />
        </mxCell>
        <mxCell id="rw1" value="多轮改写 rewrite&#xa;(query, 上下文)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#43A047;fontSize=11.5;fontColor=#1B5E20;" parent="1" vertex="1">
          <mxGeometry x="290" y="490" width="200" height="52" as="geometry" />
        </mxCell>
        <mxCell id="rw2" value="向量化 embed → q&#xa;（带 modelVersion）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#43A047;fontSize=11.5;fontColor=#1B5E20;" parent="1" vertex="1">
          <mxGeometry x="520" y="490" width="200" height="52" as="geometry" />
        </mxCell>
        <mxCell id="rw-note" value="改写 + 向量化供全部检索目标复用；embedding 模型只在此常驻，Gateway 保持轻量。改写+向量化算出的 q，透传给下方检索目标；后端不再 embed。" style="text;html=1;fontSize=10.5;align=left;spacingLeft=8;whiteSpace=wrap;fontColor=#2E7D32;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="750" y="490" width="170" height="52" as="geometry" />
        </mxCell>
        <mxCell id="bm-box" value="" style="rounded=1;fillColor=#E3F2FD;opacity=60;dashed=1;dashPattern=6 6;strokeColor=#1565C0;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="260" y="660" width="590" height="320" as="geometry" />
        </mxCell>
        <mxCell id="bm-icon" value="" style="shape=image;image=img/lib/azure2/app_services/App_Services.svg;aspect=fixed;imageWidth=28;imageHeight=28;" parent="1" vertex="1">
          <mxGeometry x="278" y="672" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="bm-hdr" value="&lt;b&gt;检索目标 · ByModel App Service&lt;/b&gt;（按车型共享 · 无 HRW / 粘性 · 轮询）" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#0D47A1;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="314" y="672" width="520" height="28" as="geometry" />
        </mxCell>
        <mxCell id="bm-lib1" value="&lt;b&gt;车书库&lt;/b&gt;&#xa;UserManual（FAISS · 只读）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=12;fontColor=#0D47A1;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="284" y="712" width="270" height="66" as="geometry" />
        </mxCell>
        <mxCell id="bm-lib2" value="&lt;b&gt;QA 库&lt;/b&gt;&#xa;QnA（FAISS · 只读）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=12;fontColor=#0D47A1;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="564" y="712" width="266" height="66" as="geometry" />
        </mxCell>
        <mxCell id="bm-cache" value="&lt;b&gt;bymodel-cache&lt;/b&gt;　车型维度语义缓存（SimpleVectorStore · 可写 · 带 expiresAt）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;fontSize=12;fontColor=#880E4F;verticalAlign=middle;dashed=1;dashPattern=4 4;spacingLeft=8;align=left;" parent="1" vertex="1">
          <mxGeometry x="284" y="790" width="546" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bm-note" value="车书/QA 离线建库经 Blob 只读同步下来（权威内容源）；缓存库运行时可写、库小用 Simple，删过期条目干净。" style="text;html=1;fontSize=10.5;align=left;spacingLeft=8;whiteSpace=wrap;fontColor=#37474F;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="284" y="858" width="546" height="110" as="geometry" />
        </mxCell>
        <mxCell id="bd-box" value="" style="rounded=1;fillColor=#FFF3E0;opacity=55;dashed=1;dashPattern=6 6;strokeColor=#CC6600;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="870" y="660" width="590" height="320" as="geometry" />
        </mxCell>
        <mxCell id="bd-icon" value="" style="shape=image;image=img/lib/azure2/app_services/App_Services.svg;aspect=fixed;imageWidth=28;imageHeight=28;" parent="1" vertex="1">
          <mxGeometry x="888" y="672" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="bd-hdr" value="&lt;b&gt;检索目标 · ByDevice App Service&lt;/b&gt;（按 deviceId · HRW + Affinity · pool N 实例）" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#BF360C;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="924" y="672" width="520" height="28" as="geometry" />
        </mxCell>
        <mxCell id="bd-lib" value="&lt;b&gt;长尾偏好库&lt;/b&gt;　long-tail-pref（SimpleVectorStore）&#xa;每 device 一份 persist · 写路径 persist 落盘 → 推回 Blob" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CC6600;fontSize=12;fontColor=#BF360C;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="894" y="712" width="546" height="66" as="geometry" />
        </mxCell>
        <mxCell id="bd-cache" value="&lt;b&gt;bydevice-cache&lt;/b&gt;　device 维度语义缓存（SimpleVectorStore · 可写 · 带 expiresAt）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;fontSize=12;fontColor=#880E4F;verticalAlign=middle;dashed=1;dashPattern=4 4;spacingLeft=8;align=left;" parent="1" vertex="1">
          <mxGeometry x="894" y="790" width="546" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bd-note" value="长尾偏好 + bydevice-cache 都按 deviceId 经 HRW + Affinity 落固定 instance，是同库不同 lib（Type 标签区分），共用一套亲和路由；缓存 TTL 短、偏好 TTL 长。" style="text;html=1;fontSize=10.5;fillColor=#FFEBEE;strokeColor=#EF5350;rounded=1;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;fontColor=#B71C1C;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="894" y="858" width="546" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cache-content" value="&lt;b&gt;缓存内容独立自成一类&lt;/b&gt;　缓存条目不是从车书/QA/长尾库查出来再复制（那样无意义），而是它自身承载的一类内容（如高频直答、预置问答对）。&lt;b&gt;缓存键&lt;/b&gt;=向量近似匹配(cosine≥阈值)+分区(customer/车型/lang/type/modelVersion)；&lt;b&gt;保存&lt;/b&gt;=结果写回打 expiresAt（bymodel 长 / bydevice 短）。" style="text;html=1;fontSize=10.5;fillColor=#FFF0F5;strokeColor=#E091B4;rounded=1;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;fontColor=#880E4F;" parent="1" vertex="1">
          <mxGeometry x="260" y="1000" width="1180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="expire-note" value="&lt;b&gt;过期机制（底层向量库无原生 TTL，须自实现两步）&lt;/b&gt;&#xa;① 逻辑过期：查询后按 expiresAt&amp;lt;now 过滤，过期条目不返回（即时生效，条目仍在库里）。&#xa;② 物理过期：独立定时 job（Azure DevOps Pipeline）周期扫 expiresAt&amp;lt;now → delete_nodes 真删 + persist，回收内存/磁盘。&#xa;仅缓存库有 expiresAt；&lt;b&gt;长尾偏好不设 TTL&lt;/b&gt;，靠记忆提炼 pipeline 覆盖写更新，不自动过期。" style="text;html=1;fontSize=10.5;fillColor=#FFF8E1;strokeColor=#F9A825;rounded=1;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;fontColor=#6D4C00;" parent="1" vertex="1">
          <mxGeometry x="260" y="1080" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="st-box" value="" style="rounded=1;fillColor=#E8EAF6;opacity=55;dashed=1;dashPattern=6 6;strokeColor=#3949AB;" parent="1" connectable="0" vertex="1">
          <mxGeometry x="700" y="1100" width="500" height="200" as="geometry" />
        </mxCell>
        <mxCell id="st-icon" value="" style="shape=image;image=img/lib/azure2/storage/Storage_Accounts.svg;aspect=fixed;imageWidth=28;imageHeight=28;" parent="1" vertex="1">
          <mxGeometry x="718" y="1112" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="st-hdr" value="&lt;b&gt;Storage Account&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#1A237E;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="754" y="1112" width="180" height="28" as="geometry" />
        </mxCell>
        <mxCell id="blob" value="&lt;b&gt;Blob Storage&lt;/b&gt;&#xa;source of truth" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#DAE8FC;strokeColor=#4472C4;fontSize=11.5;fontColor=#1F3864;" parent="1" vertex="1">
          <mxGeometry x="800" y="1152" width="120" height="110" as="geometry" />
        </mxCell>
        <mxCell id="st-note" value="离线建库产出 + 有状态库写回灌，都落这里作为权威副本。车书/QA 只读同步下行；长尾偏好写回上行。缓存库轻量、可不落 Blob（丢了重建成本低）。" style="text;html=1;fontSize=10;align=left;spacingLeft=8;whiteSpace=wrap;fontColor=#283593;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="950" y="1140" width="235" height="130" as="geometry" />
        </mxCell>

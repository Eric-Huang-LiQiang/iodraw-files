          <mxGeometry x="40" y="143" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="client-info" value="&lt;b&gt;入参&lt;/b&gt;&#xa;customer · deviceModel&#xa;language · deviceId · type" style="text;html=1;fontSize=10;fillColor=#F5F5F5;strokeColor=#CCCCCC;rounded=1;align=left;spacingLeft=8;spacingTop=4;whiteSpace=wrap;fontColor=#455A64;" parent="1" vertex="1">

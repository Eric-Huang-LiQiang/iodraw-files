<mxfile host="iodraw" type="device"><diagram id="device-tools" name="车机Function注册与检索"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2410" pageHeight="1440" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;车机 Function 注册并参与语义检索比对（设计稿 v3，定稿待审）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=24;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1800" height="34" as="geometry"/></mxCell><mxCell id="subtitle" value="通用 function（27 个，Locale=en-US）所有车都参与比对；车机按名字提交自己的全量 function，同名时这台车只用注册的那条；向量库按 语言 + 车企 + 车型 划分，常驻站点内存，变化后整库上传 Blob；SQL 是唯一可信数据。" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#4B5563;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="2340" height="24" as="geometry"/></mxCell><mxCell id="steps" value="&lt;b&gt;&lt;font color=&#x27;#1D6FD8&#x27;&gt;注册&lt;/font&gt;&lt;/b&gt;：① 车机提交全量 MCP（请求头带 Language）→ ② 设备网关鉴权转发 → ③ 向量服务按名字比对、一个事务写库 → ④ 调这台车所在库的站点实时更新 → ⑤ 站点读工具行 → ⑥ 算描述向量 → ⑦ 后台整库上传 Blob　　&lt;b&gt;&lt;font color=&#x27;#7A4FC4&#x27;&gt;检索&lt;/font&gt;&lt;/b&gt;：Ⓐ 改写问句并算向量 → Ⓑ 按 车企 + 车型 + 语言 选站点和库 → Ⓒ 查这台车的映射 → Ⓓ 同名覆盖后按 Id 过滤比对" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#374151;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="84" width="2340" height="24" as="geometry"/></mxCell><mxCell id="s-car" value="" style="rounded=1;arcSize=2;html=1;fillColor=#F5F6F8;strokeColor=#6B7280;dashed=1;dashPattern=8 4;strokeWidth=1.5;" vertex="1" parent="1" connectable="0"><mxGeometry x="30" y="140" width="280" height="450" as="geometry"/></mxCell><mxCell id="s-car-title" value="&lt;b&gt;车机&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#6B7280;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="46" y="150" width="248" height="28" as="geometry"/></mxCell><mxCell id="c-car" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="46" y="186" width="248" height="230" as="geometry"/></mxCell><mxCell id="c-car-title" value="&lt;b&gt;车机 SDK&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27; style=&#x27;font-size:11px&#x27;&gt;MCP 命令组暴露的工具&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c-car"><mxGeometry x="12" y="8" width="226" height="44" as="geometry"/></mxCell><mxCell id="c-car-body" value="启动时 registerTools 上报&lt;br&gt;提交这台车自己的全量 MCP&lt;br&gt;（只含差异化的，不含通用 function）&lt;br&gt;请求体：MCP 工具数组（格式不变）&lt;br&gt;请求头：api-key、customer、DeviceId、&lt;br&gt;DeviceModel、UserId（已有）&lt;br&gt;新增请求头 Language =&lt;br&gt;assistantConfiguration.Locale" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c-car"><mxGeometry x="12" y="58" width="224" height="166" as="geometry"/></mxCell><mxCell id="s-dg" value="" style="rounded=1;arcSize=2;html=1;fillColor=#F5F6F8;strokeColor=#6B7280;dashed=1;dashPattern=8 4;strokeWidth=1.5;" vertex="1" parent="1" connectable="0"><mxGeometry x="350" y="140" width="330" height="450" as="geometry"/></mxCell><mxCell id="s-dg-title" value="&lt;b&gt;设备网关  Assistant.DeviceGateway&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#6B7280;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="366" y="150" width="298" height="28" as="geometry"/></mxCell><mxCell id="c-dg" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="366" y="186" width="298" height="200" as="geometry"/></mxCell><mxCell id="c-dg-icon" value="" style="shape=image;html=1;image=img/lib/azure2/app_services/App_Services.svg;aspect=fixed;imageAspect=0;" vertex="1" parent="c-dg"><mxGeometry x="12" y="12" width="36" height="36" as="geometry"/></mxCell><mxCell id="c-dg-title" value="&lt;b&gt;POST /Device/RegisterTools&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27; style=&#x27;font-size:11px&#x27;&gt;新增接口，只做鉴权和转发&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c-dg"><mxGeometry x="56" y="8" width="232" height="44" as="geometry"/></mxCell><mxCell id="c-dg-body" value="ApiKey 中间件：解密后须等于 DeviceId&lt;br&gt;请求头 customer、DeviceId、DeviceModel、&lt;br&gt;Language、ApiVersion + 工具数组&lt;br&gt;→ 向量服务的请求体&lt;br&gt;不碰配置库，不含任何向量逻辑" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c-dg"><mxGeometry x="12" y="58" width="274" height="136" as="geometry"/></mxCell><mxCell id="s-vs1" value="" style="rounded=1;arcSize=2;html=1;fillColor=#FEF5E7;strokeColor=#D97706;dashed=1;dashPattern=8 4;strokeWidth=1.5;" vertex="1" parent="1" connectable="0"><mxGeometry x="720" y="140" width="640" height="450" as="geometry"/></mxCell><mxCell id="s-vs1-title" value="&lt;b&gt;向量服务  Assistant.Service.Vector · 注册&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#D97706;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="736" y="150" width="608" height="28" as="geometry"/></mxCell><mxCell id="c-reg" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="736" y="186" width="330" height="330" as="geometry"/></mxCell><mxCell id="c-reg-icon" value="" style="shape=image;html=1;image=img/lib/azure2/app_services/App_Services.svg;aspect=fixed;imageAspect=0;" vertex="1" parent="c-reg"><mxGeometry x="12" y="12" width="36" height="36" as="geometry"/></mxCell><mxCell id="c-reg-title" value="&lt;b&gt;POST /Vector/RegisterDeviceTools&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27; style=&#x27;font-size:11px&#x27;&gt;新增接口，注册逻辑全在这里&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c-reg"><mxGeometry x="56" y="8" width="264" height="44" as="geometry"/></mxCell><mxCell id="c-reg-body" value="Customer、DeviceModel 统一 Trim + 小写&lt;br&gt;按 车企 + 车型 + 语言 加锁，查一次库读两张对照表&lt;br&gt;以 function 名字为准（忽略大小写）逐个比：&lt;br&gt;　已有、描述相同 → 不动&lt;br&gt;　已有、描述不同 → 就地更新工具行和函数行&lt;br&gt;　没有 → 共用对照表里有名字 + 描述相同的&lt;br&gt;　　就复用，没有就新建&lt;br&gt;　这次没提交的名字 → 软删除映射&lt;br&gt;通用 function（挂模板的行）一律不碰&lt;br&gt;一个事务提交，再调站点 ④；&lt;br&gt;调用失败只记日志，不影响注册结果" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c-reg"><mxGeometry x="12" y="58" width="306" height="266" as="geometry"/></mxCell><mxCell id="c-notify" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1086" y="186" width="258" height="190" as="geometry"/></mxCell><mxCell id="c-notify-title" value="&lt;b&gt;调站点实时更新库&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27; style=&#x27;font-size:11px&#x27;&gt;提交后，库要变才调&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c-notify"><mxGeometry x="12" y="8" width="236" height="44" as="geometry"/></mxCell><mxCell id="c-notify-body" value="按 (车企, 车型, 语言) 查一次路由，&lt;br&gt;车型为空的路由行 = 该车企所有车型通用&lt;br&gt;带上两个 Id 列表：要更新向量的、&lt;br&gt;可能要删向量的&lt;br&gt;不等 Blob 上传" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c-notify"><mxGeometry x="12" y="58" width="234" height="126" as="geometry"/></mxCell><mxCell id="c-route" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1086" y="396" width="258" height="110" as="geometry"/></mxCell><mxCell id="c-route-title" value="&lt;b&gt;路由快照（内存）&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27; style=&#x27;font-size:11px&#x27;&gt;来自配置库两张路由表&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c-route"><mxGeometry x="12" y="8" width="236" height="44" as="geometry"/></mxCell><mxCell id="c-route-body" value="按 (车企, 车型, 语言) 查一次，不查库&lt;br&gt;车型为空的行 = 该车企所有车型通用" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c-route"><mxGeometry x="12" y="58" width="234" height="46" as="geometry"/></mxCell><mxCell id="s-db" value="" style="rounded=1;arcSize=2;html=1;fillColor=#EAF6EF;strokeColor=#1E8E5A;dashed=1;dashPattern=8 4;strokeWidth=1.5;" vertex="1" parent="1" connectable="0"><mxGeometry x="30" y="630" width="1330" height="330" as="geometry"/></mxCell><mxCell id="s-db-title" value="&lt;b&gt;配置库  ms-incarva-dev-v3-gateway&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#1E8E5A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="46" y="640" width="1298" height="28" as="geometry"/></mxCell><mxCell id="n-rule" value="&lt;b&gt;通用 function 和注册 function&lt;/b&gt;&lt;br&gt;通用：27 个挂在 LLM 代理模板下的工具行，Locale=en-US（用户跑 SQL 设），所有车都参与比对。&lt;br&gt;注册：车机提交的工具行，PromptTemplateId 为空，只对引用它的车生效。&lt;br&gt;同名时注册的优先：通用有 AC、这台车也注册了 AC，只用注册的 AC；表里有两行 AC。&lt;br&gt;同车企 + 车型 + 语言的车，名字 + 描述相同就共用一行；改描述时就地更新，共用的车一起变。" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#CCCCCC;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="46" y="676" width="270" height="270" as="geometry"/></mxCell><mxCell id="c-tool" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E8E5A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="346" y="676" width="300" height="170" as="geometry"/></mxCell><mxCell id="c-tool-title" value="&lt;b&gt;[LLM].[PromptMessageTool]&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27; style=&#x27;font-size:11px&#x27;&gt;通用和注册的工具都在这张表&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c-tool"><mxGeometry x="12" y="8" width="278" height="44" as="geometry"/></mxCell><mxCell id="c-tool-body" value="注册行：Name、Description = MCP 原文&lt;br&gt;Locale = 请求头 Language；PromptTemplateId = 空&lt;br&gt;Type=function，EType=2705，ExternalApi=0&lt;br&gt;Value = 原始 MCP JSON；FunctionId → 函数行&lt;br&gt;就地更新描述时同时更新 Updated" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c-tool"><mxGeometry x="12" y="58" width="276" height="106" as="geometry"/></mxCell><mxCell id="c-func" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E8E5A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="346" y="866" width="300" height="80" as="geometry"/></mxCell><mxCell id="c-func-title" value="&lt;b&gt;[LLM].[PromptMessageToolFunction]&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c-func"><mxGeometry x="12" y="8" width="278" height="24" as="geometry"/></mxCell><mxCell id="c-func-body" value="函数行：EType=2706，名字、描述同工具行&lt;br&gt;ParameterId 空（不拆参数表），Domain=&#x27;&#x27;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c-func"><mxGeometry x="12" y="38" width="276" height="36" as="geometry"/></mxCell><mxCell id="c-map" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF6EF;strokeColor=#1E8E5A;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="760" y="676" width="274" height="175" as="geometry"/></mxCell><mxCell id="c-map-title" value="&lt;b&gt;[Device].[DeviceToolMapping]&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27; style=&#x27;font-size:11px&#x27;&gt;映射表（新建）&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c-map"><mxGeometry x="12" y="8" width="252" height="44" as="geometry"/></mxCell><mxCell id="c-map-body" value="Customer、DeviceModel（小写）、DeviceId、&lt;br&gt;PromptMessageToolId、Deleted&lt;br&gt;唯一：(Customer, DeviceModel, DeviceId,&lt;br&gt;　PromptMessageToolId)&lt;br&gt;名字和语言取自工具行；删除 = 软删除&lt;br&gt;另有索引：按工具 Id 查哪个车企车型在用" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c-map"><mxGeometry x="12" y="58" width="250" height="111" as="geometry"/></mxCell><mxCell id="c-builtin" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E8E5A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1086" y="820" width="258" height="126" as="geometry"/></mxCell><mxCell id="c-builtin-title" value="&lt;b&gt;通用 function 的链路&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27; style=&#x27;font-size:11px&#x27;&gt;模型 → 分组 → 代理 LLM → 模板 → 工具行&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c-builtin"><mxGeometry x="12" y="8" width="236" height="44" as="geometry"/></mxCell><mxCell id="c-builtin-body" value="新增条件：Locale = 库的语言&lt;br&gt;27 个现在 Locale 为空：&lt;br&gt;先跑 SQL 设成 en-US，再上线站点" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c-builtin"><mxGeometry x="12" y="58" width="234" height="62" as="geometry"/></mxCell><mxCell id="s-caller" value="" style="rounded=1;arcSize=2;html=1;fillColor=#F5F6F8;strokeColor=#6B7280;dashed=1;dashPattern=8 4;strokeWidth=1.5;" vertex="1" parent="1" connectable="0"><mxGeometry x="30" y="1000" width="280" height="270" as="geometry"/></mxCell><mxCell id="s-caller-title" value="&lt;b&gt;调用方&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#6B7280;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="46" y="1010" width="248" height="28" as="geometry"/></mxCell><mxCell id="c-caller" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="46" y="1071" width="248" height="150" as="geometry"/></mxCell><mxCell id="c-caller-title" value="&lt;b&gt;如网关的意图分类器&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27; style=&#x27;font-size:11px&#x27;&gt;每句话检索一次&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c-caller"><mxGeometry x="12" y="8" width="226" height="44" as="geometry"/></mxCell><mxCell id="c-caller-body" value="请求带 Customer、DeviceModel、&lt;br&gt;DeviceId、Language、问句&lt;br&gt;取前 3 名的 Answer（工具名）作为候选领域" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c-caller"><mxGeometry x="12" y="58" width="224" height="86" as="geometry"/></mxCell><mxCell id="s-vs2" value="" style="rounded=1;arcSize=2;html=1;fillColor=#FEF5E7;strokeColor=#D97706;dashed=1;dashPattern=8 4;strokeWidth=1.5;" vertex="1" parent="1" connectable="0"><mxGeometry x="720" y="1000" width="330" height="270" as="geometry"/></mxCell><mxCell id="s-vs2-title" value="&lt;b&gt;向量服务 · 检索&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#D97706;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="736" y="1010" width="298" height="28" as="geometry"/></mxCell><mxCell id="c-vsearch" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="736" y="1046" width="290" height="200" as="geometry"/></mxCell><mxCell id="c-vsearch-icon" value="" style="shape=image;html=1;image=img/lib/azure2/app_services/App_Services.svg;aspect=fixed;imageAspect=0;" vertex="1" parent="c-vsearch"><mxGeometry x="12" y="12" width="36" height="36" as="geometry"/></mxCell><mxCell id="c-vsearch-title" value="&lt;b&gt;/Vector/SearchSemanticSearch&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27; style=&#x27;font-size:11px&#x27;&gt;现有接口&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c-vsearch"><mxGeometry x="56" y="8" width="224" height="44" as="geometry"/></mxCell><mxCell id="c-vsearch-body" value="Ⓐ 问句交 embeddings App Service：&lt;br&gt;　多轮时先改写，再算成问句向量&lt;br&gt;Ⓑ 车型必填；按 车企 + 车型 + 语言 查路由，&lt;br&gt;　车型为空的路由行 = 该车企所有车型通用&lt;br&gt;新增：把 Customer、DeviceModel、&lt;br&gt;　DeviceId 传给站点；返回格式不变" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c-vsearch"><mxGeometry x="12" y="58" width="266" height="136" as="geometry"/></mxCell><mxCell id="s-embsvc" value="" style="rounded=1;arcSize=2;html=1;fillColor=#F5F6F8;strokeColor=#6B7280;dashed=1;dashPattern=8 4;strokeWidth=1.5;" vertex="1" parent="1" connectable="0"><mxGeometry x="1070" y="1000" width="290" height="140" as="geometry"/></mxCell><mxCell id="s-embsvc-title" value="&lt;b&gt;embeddings App Service&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#6B7280;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1086" y="1010" width="258" height="28" as="geometry"/></mxCell><mxCell id="c-embsvc" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1086" y="1046" width="258" height="80" as="geometry"/></mxCell><mxCell id="c-embsvc-title" value="&lt;b&gt;改写 + 算问句向量&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27; style=&#x27;font-size:11px&#x27;&gt;向量服务后面的 Python 服务&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c-embsvc"><mxGeometry x="12" y="8" width="236" height="44" as="geometry"/></mxCell><mxCell id="c-embsvc-body" value="多轮先改写问句，再算向量" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c-embsvc"><mxGeometry x="12" y="58" width="234" height="16" as="geometry"/></mxCell><mxCell id="s-site" value="" style="rounded=1;arcSize=2;html=1;fillColor=#F3EEFB;strokeColor=#7A4FC4;dashed=1;dashPattern=8 4;strokeWidth=1.5;" vertex="1" parent="1" connectable="0"><mxGeometry x="1400" y="140" width="650" height="1130" as="geometry"/></mxCell><mxCell id="s-site-title" value="&lt;b&gt;语义检索站点  ms-incarva-dev-vector-semanticsearch&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#7A4FC4;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1416" y="150" width="618" height="28" as="geometry"/></mxCell><mxCell id="t-site" value="向量服务后面的 Python App Service 之一；路由只决定站点，站点里按请求的车型分库；单实例（gunicorn -w 1）" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#6B21A8;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1416" y="176" width="618" height="30" as="geometry"/></mxCell><mxCell id="c-api" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A4FC4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1416" y="216" width="618" height="150" as="geometry"/></mxCell><mxCell id="c-api-icon" value="" style="shape=image;html=1;image=img/lib/azure2/app_services/App_Services.svg;aspect=fixed;imageAspect=0;" vertex="1" parent="c-api"><mxGeometry x="12" y="12" width="36" height="36" as="geometry"/></mxCell><mxCell id="c-api-title" value="&lt;b&gt;POST /semantic-search/library/update&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27; style=&#x27;font-size:11px&#x27;&gt;新增接口：注册后实时更新一个库&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c-api"><mxGeometry x="56" y="8" width="552" height="44" as="geometry"/></mxCell><mxCell id="c-api-body" value="⑤ 要更新向量的工具 Id：库里没有或 Updated 对不上的读工具行；⑥ 算向量，写锁加入或替换&lt;br&gt;可能要删向量的工具 Id：这个车企 + 车型 + 语言里没有有效映射引用了 → 从库里删掉&lt;br&gt;库还不存在就先建（只含通用 function）&lt;br&gt;⑦ 标记待上传，返回；后台线程整库上传 Blob，不阻塞注册" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c-api"><mxGeometry x="12" y="58" width="594" height="86" as="geometry"/></mxCell><mxCell id="c-faiss" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3EEFB;strokeColor=#7A4FC4;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1416" y="392" width="618" height="150" as="geometry"/></mxCell><mxCell id="c-faiss-title" value="&lt;b&gt;内存：FAISS 库（每个 语言 + 车企 + 车型 一个，常驻）&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27; style=&#x27;font-size:11px&#x27;&gt;IndexIDMap2（IndexFlatIP）&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c-faiss"><mxGeometry x="12" y="8" width="596" height="44" as="geometry"/></mxCell><mxCell id="c-faiss-body" value="通用 function（Locale = 库的语言）+ 这个车企、车型、语言下被引用的注册工具&lt;br&gt;每个工具 Id 一份向量，并记下算向量时工具行的 Updated&lt;br&gt;容量只跟工具行数量有关，不随车辆数增长（一条 12 KB，1 万条约 0.11 GB）&lt;br&gt;检索拿读锁，增删改拿写锁；FAISS 的 Id 是整数，内存里维护“整数 ↔ 工具 Id”" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c-faiss"><mxGeometry x="12" y="58" width="594" height="86" as="geometry"/></mxCell><mxCell id="c-allow" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3EEFB;strokeColor=#7A4FC4;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="1416" y="568" width="618" height="160" as="geometry"/></mxCell><mxCell id="c-allow-title" value="&lt;b&gt;Ⓒ 每次检索查一次映射表&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27; style=&#x27;font-size:11px&#x27;&gt;不在内存里缓存“车辆 → 工具”&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c-allow"><mxGeometry x="12" y="8" width="596" height="44" as="geometry"/></mxCell><mxCell id="c-allow-body" value="SELECT t.Id, t.Name, t.Updated FROM 映射表 m JOIN 工具行 t&lt;br&gt;　WHERE m.Customer, m.DeviceId, m.Deleted=0, t.Locale = 语言&lt;br&gt;Ⓓ 允许集合 = 这台车注册的工具 + 名字没被这台车注册过的通用 function&lt;br&gt;补缺：库里没有这个 Id，或 Updated 对不上 → 只为这几条算向量并排上传" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c-allow"><mxGeometry x="12" y="58" width="594" height="96" as="geometry"/></mxCell><mxCell id="c-start" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A4FC4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1416" y="754" width="618" height="130" as="geometry"/></mxCell><mxCell id="c-start-title" value="&lt;b&gt;启动  /  POST /semantic-search/refresh&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27; style=&#x27;font-size:11px&#x27;&gt;和 SQL 比对后补齐&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c-start"><mxGeometry x="12" y="8" width="596" height="44" as="geometry"/></mxCell><mxCell id="c-start-body" value="加载本站点负责的 语言 + 车企 下：Blob 已有的车型目录 ∪ 映射表出现过的车型&lt;br&gt;和 SQL 比对：缺的、Updated 对不上的重算；不再被引用的删掉&lt;br&gt;manifest 里的模型和当前配置不一致 → 整库重算；Blob 里没有 → 按 SQL 现建&lt;br&gt;有变化就上传；全部加载完 /health 才返回 200" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c-start"><mxGeometry x="12" y="58" width="594" height="66" as="geometry"/></mxCell><mxCell id="c-ssearch" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A4FC4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1416" y="1046" width="618" height="175" as="geometry"/></mxCell><mxCell id="c-ssearch-title" value="&lt;b&gt;POST /semantic-search/search&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27; style=&#x27;font-size:11px&#x27;&gt;站点不算问句向量：由向量服务算好传来&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c-ssearch"><mxGeometry x="12" y="8" width="596" height="44" as="geometry"/></mxCell><mxCell id="c-ssearch-body" value="按 语言 + 车企 + 车型 选库，库不存在就现建&lt;br&gt;用传来的问句向量，在 Ⓓ 允许集合里按 Id 过滤检索&lt;br&gt;　（本机实测：5027 条里 1.4 ms，结果与逐个算内积一致）&lt;br&gt;不会混入别的车的工具；没注册过的车结果和现在一样&lt;br&gt;返回前 3 名：name、description、score、toolId" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c-ssearch"><mxGeometry x="12" y="58" width="594" height="111" as="geometry"/></mxCell><mxCell id="s-ext" value="" style="rounded=1;arcSize=2;html=1;fillColor=#F5F6F8;strokeColor=#6B7280;dashed=1;dashPattern=8 4;strokeWidth=1.5;" vertex="1" parent="1" connectable="0"><mxGeometry x="2090" y="140" width="290" height="500" as="geometry"/></mxCell><mxCell id="s-ext-title" value="&lt;b&gt;外部依赖&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#6B7280;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2106" y="150" width="258" height="28" as="geometry"/></mxCell><mxCell id="c-emb" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2106" y="186" width="258" height="170" as="geometry"/></mxCell><mxCell id="c-emb-icon" value="" style="shape=image;html=1;image=img/lib/azure2/ai_machine_learning/Azure_OpenAI.svg;aspect=fixed;imageAspect=0;" vertex="1" parent="c-emb"><mxGeometry x="12" y="12" width="36" height="36" as="geometry"/></mxCell><mxCell id="c-emb-title" value="&lt;b&gt;Azure OpenAI embedding&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27; style=&#x27;font-size:11px&#x27;&gt;text-embedding-3-large&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c-emb"><mxGeometry x="56" y="8" width="192" height="44" as="geometry"/></mxCell><mxCell id="c-emb-body" value="function 描述算向量：站点&lt;br&gt;问句算向量：embeddings 服务&lt;br&gt;两边必须同一个模型，&lt;br&gt;分数才可比" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c-emb"><mxGeometry x="12" y="58" width="234" height="106" as="geometry"/></mxCell><mxCell id="c-blob" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2106" y="380" width="258" height="240" as="geometry"/></mxCell><mxCell id="c-blob-icon" value="" style="shape=image;html=1;image=img/lib/azure2/storage/Storage_Accounts.svg;aspect=fixed;imageAspect=0;" vertex="1" parent="c-blob"><mxGeometry x="12" y="12" width="36" height="36" as="geometry"/></mxCell><mxCell id="c-blob-title" value="&lt;b&gt;Storage account（Blob）&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#666666&#x27; style=&#x27;font-size:11px&#x27;&gt;msincarvav3blobdev / 容器 vector&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c-blob"><mxGeometry x="56" y="8" width="192" height="44" as="geometry"/></mxCell><mxCell id="c-blob-body" value="semanticsearch/{语言}/{车企}/{车型}/&lt;br&gt;　vectorDatabase/（车企、车型小写）&lt;br&gt;例：semanticsearch/en-US/rox/mce/&lt;br&gt;整库存，文件和 cache/ 下的库一样，&lt;br&gt;含 embedding_manifest.json&lt;br&gt;目录不存在时上传自动创建&lt;br&gt;失败重试；SQL 可重建" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c-blob"><mxGeometry x="12" y="58" width="234" height="176" as="geometry"/></mxCell><mxCell id="n-vec" value="&lt;b&gt;向量什么时候变（没有过期时间）&lt;/b&gt;&lt;br&gt;新注册一个工具：算一条，加入库&lt;br&gt;描述就地更新：重算这一条，替换旧的&lt;br&gt;这个库里不再有有效映射引用某个注册工具：删掉这一条&lt;br&gt;通用 function 描述改了：refresh 或重启时重算&lt;br&gt;换 embedding 模型：整库重算&lt;br&gt;其它情况：不变&lt;br&gt;&lt;br&gt;&lt;b&gt;名字不同、功能相同&lt;/b&gt;（如 climate_ac 和 AC）：不处理，两条都参与比对。离线实测通用 27 个 + SDK 样例 16 个：Top1 82.27% → 73.65%，Top3 95.27% → 93.50%" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#CCCCCC;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="2090" y="670" width="290" height="330" as="geometry"/></mxCell><mxCell id="n-platform" value="&lt;b&gt;向量平台的组成&lt;/b&gt;&lt;br&gt;向量服务 Assistant.Service.Vector（C#）：对外接口、路由、读写配置库。&lt;br&gt;后面的 Python App Service：embeddings（改写 + 向量化）、bymodel（车书 / QnA）、bydevice（设备记忆）、semanticcache（语义缓存）、semanticsearch（语义检索，本图）。&lt;br&gt;设备网关、对话网关只调向量服务的接口。" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#CCCCCC;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="2090" y="1030" width="290" height="240" as="geometry"/></mxCell><mxCell id="e-r1" value="① 上报" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#1D6FD8;fontColor=#1D6FD8;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4348;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-car" target="c-dg"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-r2" value="② 转发" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#1D6FD8;fontColor=#1D6FD8;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.303;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-dg" target="c-reg"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-r3" value="③ 就地更新 / 新建工具行" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#1D6FD8;fontColor=#1D6FD8;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-reg" target="c-tool"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="802" y="610"/><mxPoint x="466" y="610"/></Array></mxGeometry></mxCell><mxCell id="e-r4" value="③ 增 / 软删映射" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#1D6FD8;fontColor=#1D6FD8;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.635;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-reg" target="c-map"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-n1" value="④" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#D97706;fontColor=#D97706;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.303;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-reg" target="c-notify"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-n2" value="查路由" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#D97706;fontColor=#D97706;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-notify" target="c-route"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-n3" value="④ 更新库" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#D97706;fontColor=#D97706;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-notify" target="c-api"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id=
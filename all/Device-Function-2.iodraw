ckgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-api" target="c-faiss"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-s1" value="Ⓐ 每句话检索" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#7A4FC4;fontColor=#7A4FC4;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-caller" target="c-vsearch"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-x2" value="Ⓐ 算向量" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#6B7280;fontColor=#6B7280;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-vsearch" target="c-embsvc"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-s2" value="Ⓑ 选站点和库，带上问句向量" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#7A4FC4;fontColor=#7A4FC4;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-vsearch" target="c-ssearch"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lg-box" value="" style="rounded=1;arcSize=12;html=1;fillColor=#FAFAFA;strokeColor=#CCCCCC;" vertex="1" parent="1" connectable="0"><mxGeometry x="30" y="1310" width="1484.8" height="44" as="geometry"/></mxCell><mxCell id="lg-title" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="46" y="1310" width="50" height="44" as="geometry"/></mxCell><mxCell id="lg-s0" value="" style="line;html=1;strokeWidth=2;strokeColor=#1D6FD8;" vertex="1" parent="1"><mxGeometry x="106" y="1327.0" width="40" height="10" as="geometry"/></mxCell><mxCell id="lg-t0" value="注册写入" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="154" y="1310" width="60" height="44" as="geometry"/></mxCell><mxCell id="lg-s1" value="" style="line;html=1;strokeWidth=2;strokeColor=#1E8E5A;" vertex="1" parent="1"><mxGeometry x="238" y="1327.0" width="40" height="10" as="geometry"/></mxCell><mxCell id="lg-t1" value="读配置库" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="286" y="1310" width="60" height="44" as="geometry"/></mxCell><mxCell id="lg-s2" value="" style="line;html=1;strokeWidth=2;strokeColor=#1E8E5A;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="370" y="1327.0" width="40" height="10" as="geometry"/></mxCell><mxCell id="lg-t2" value="表之间的引用" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="418" y="1310" width="84" height="44" as="geometry"/></mxCell><mxCell id="lg-s3" value="" style="line;html=1;strokeWidth=2;strokeColor=#D97706;" vertex="1" parent="1"><mxGeometry x="526" y="1327.0" width="40" height="10" as="geometry"/></mxCell><mxCell id="lg-t3" value="实时更新库、上传 Blob" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="574" y="1310" width="142.79999999999998" height="44" as="geometry"/></mxCell><mxCell id="lg-s4" value="" style="line;html=1;strokeWidth=2;strokeColor=#D97706;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="740.8" y="1327.0" width="40" height="10" as="geometry"/></mxCell><mxCell id="lg-t4" value="启动时从 Blob 下载" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="788.8" y="1310" width="125.75999999999999" height="44" as="geometry"/></mxCell><mxCell id="lg-s5" value="" style="line;html=1;strokeWidth=2;strokeColor=#7A4FC4;" vertex="1" parent="1"><mxGeometry x="938.56" y="1327.0" width="40" height="10" as="geometry"/></mxCell><mxCell id="lg-t5" value="检索" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="986.56" y="1310" width="36" height="44" as="geometry"/></mxCell><mxCell id="lg-s6" value="" style="line;html=1;strokeWidth=2;strokeColor=#6B7280;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1046.56" y="1327.0" width="40" height="10" as="geometry"/></mxCell><mxCell id="lg-t6" value="调 embedding 模型" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1094.56" y="1310" width="124.55999999999999" height="44" as="geometry"/></mxCell><mxCell id="lg-s7" value="" style="rounded=1;html=1;fillColor=#EAF6EF;strokeColor=#1E8E5A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1243.12" y="1323.0" width="40" height="18" as="geometry"/></mxCell><mxCell id="lg-t7" value="重点：映射表、FAISS 库、Ⓒ 查库" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1291.12" y="1310" width="199.67999999999998" height="44" as="geometry"/></mxCell><mxCell id="foot" value="设计文档：docs/Device-Function-Registration-Design.md（v3）。内存估算：若把“车辆→工具”也缓存，10 万台车约 150 MB、100 万台约 1.5 GB，故每次检索查库。&lt;br&gt;[未查证]：线上语义检索站点实例数（需 Azure 授权）；设备网关能否访问向量服务（向量服务代码注释写着只允许同一虚拟网络内的网关访问）；车机非并行模式不发 ApiVersion 时设备网关怎么选服务实现。" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#6B7280;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1366" width="2350" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>

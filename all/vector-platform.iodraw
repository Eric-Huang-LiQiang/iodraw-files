          <mxGeometry x="1260" y="1050" width="120" height="110" as="geometry" />
        </mxCell>
        <mxCell id="st-note" value="离线建库产出 + 有状态库写回灌，都落这里作为权威副本。" style="text;html=1;fontSize=10;align=left;spacingLeft=8;whiteSpace=wrap;fontColor=#283593;" parent="1" vertex="1">
          <mxGeometry x="1208" y="1180" width="215" height="60" as="geometry" />

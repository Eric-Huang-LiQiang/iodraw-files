        <mxCell id="titlebar" value="" style="rounded=0;fillColor=#1A237E;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry width="1680" height="78" as="geometry" />
        </mxCell>
        <mxCell id="title" value="向量平台架构 · Vector Gateway 统一编排（车书/QA · 长尾偏好 · 语义缓存 三类并列检索目标）" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#FFFFFF;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="30" y="12" width="1300" height="32" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Gateway：改写 → 向量化 → 按 type 路由到检索目标；语义缓存与车书/QA、长尾偏好并列（不是前置短路），存 AI Search，内容独立自成一类" style="text;html=1;fontSize=12;fontColor=#C5CAE9;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="32" y="44" width="1400" height="22" as="geometry" />
        </mxCell>
        <mxCell id="client" value="&lt;b&gt;Client&lt;/b&gt;&#xa;query · update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;fontSize=13;fontColor=#263238;verticalAlign=top;spacingTop=10;" parent="1" vertex="1">
          <mxGeometry x="40" y="150" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="client-info" value="&lt;b&gt;入参&lt;/b&gt;&#xa;customer · deviceModel&#xa;language · deviceId · type" style="text;html=1;fontSize=10;fillColor=#F5F5F5;strokeColor=#CCCCCC;rounded=1;align=left;spacingLeft=8;spacingTop=4;whiteSpace=wrap;fontColor=#455A64;" parent="1" vertex="1">
          <mxGeometry x="40" y="250" width="150" height="66" as="geometry" />
        </mxCell>
        <mxCell id="gw-box" value="" style="rounded=1;fillColor=#EDE7F6;opacity=60;dashed=1;dashPattern=6 6;strokeColor=#5E35B1;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="250" y="100" width="1180" height="240" as="geometry" />
        </mxCell>
        <mxCell id="gw-icon" value="" style="shape=image;image=img/lib/azure2/app_services/App_Services.svg;aspect=fixed;imageWidth=28;imageHeight=28;" parent="1" vertex="1">
          <mxGeometry x="268" y="112" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="gw-hdr" value="&lt;b&gt;Vector Gateway&lt;/b&gt;　查询/更新统一入口 · 编排层（无状态，可横向扩）" style="text;html=1;fontSize=13.5;fontStyle=1;fontColor=#4527A0;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="300" y="112" width="604" height="28" as="geometry" />
        </mxCell>
        <mxCell id="gw-entry" value="①　统一入口&#xa;/vector　query + update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E57C2;fontSize=12;fontColor=#311B92;" parent="1" vertex="1">
          <mxGeometry x="280" y="158" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gw-rw" value="②　调改写服务&#xa;→ 改写后 query" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E57C2;fontSize=12;fontColor=#311B92;" parent="1" vertex="1">
          <mxGeometry x="510" y="158" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gw-embed" value="③　向量化&#xa;→ query 向量 q" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E57C2;fontSize=12;fontColor=#311B92;" parent="1" vertex="1">
          <mxGeometry x="720" y="158" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gw-route" value="④　按 type 路由到检索目标&#xa;（透传 q，后端不再 embed）&#xa;车书/QA｜长尾偏好｜语义缓存 三类并列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E57C2;fontSize=12;fontColor=#311B92;" parent="1" vertex="1">
          <mxGeometry x="930" y="158" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gw-hrw" value="&lt;b&gt;HRW&lt;/b&gt;　key=deviceId · N 选一（抖动 1/N）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#CC6600;fontSize=11;fontColor=#BF360C;" parent="1" vertex="1">
          <mxGeometry x="1190" y="158" width="220" height="28" as="geometry" />
        </mxCell>
        <mxCell id="gw-aff" value="&lt;b&gt;Session Affinity&lt;/b&gt;　钉 deviceId 到固定 instance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#CC6600;fontSize=11;fontColor=#BF360C;" parent="1" vertex="1">
          <mxGeometry x="1190" y="190" width="220" height="28" as="geometry" />
        </mxCell>
        <mxCell id="gw-note" value="只读库（车书/QA）数据库配置 URL，任意副本轮询，不走 HRW。语义缓存是与车书/QA、长尾偏好并列的一类检索目标 —— 命中与否不改变其它目标的调用（不是前置短路）；仅长尾偏好走 HRW + Session Affinity。" style="text;html=1;fontSize=10.5;fillColor=#F3E5F5;strokeColor=#CE93D8;rounded=1;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;fontColor=#6A1B9A;" parent="1" vertex="1">
          <mxGeometry x="280" y="240" width="1130" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rw-box" value="" style="rounded=1;fillColor=#E8F5E9;opacity=60;dashed=1;dashPattern=6 6;strokeColor=#2E7D32;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="260" y="440" width="1180" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rw-hdr" value="&lt;b&gt;改写服务 App Service&lt;/b&gt;（无状态 · 可横向扩）" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#1B5E20;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="312" y="452" width="400" height="26" as="geometry" />
        </mxCell>
        <mxCell id="rw1" value="多轮改写 rewrite&#xa;(query, 上下文)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#43A047;fontSize=11.5;fontColor=#1B5E20;" parent="1" vertex="1">
          <mxGeometry x="290" y="490" width="200" height="52" as="geometry" />
        </mxCell>
        <mxCell id="rw2" value="向量化 embed → q&#xa;（带 modelVersion）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#43A047;fontSize=11.5;fontColor=#1B5E20;" parent="1" vertex="1">
          <mxGeometry x="520" y="490" width="200" height="52" as="geometry" />
        </mxCell>
        <mxCell id="rw-note" value="改写 + 向量化供全部检索目标复用；embedding 模型只在此常驻，Gateway 保持轻量。" style="text;html=1;fontSize=10.5;align=left;spacingLeft=8;whiteSpace=wrap;fontColor=#2E7D32;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="750" y="490" width="670" height="52" as="geometry" />
        </mxCell>
        <mxCell id="rw-note2" value="改写+向量化算出的 q，透传给下方三类检索目标；后端不再 embed。" style="text;html=1;fontSize=10;align=left;spacingLeft=8;whiteSpace=wrap;fontColor=#2E7D32;" parent="1" vertex="1">
          <mxGeometry x="290" y="552" width="1130" height="28" as="geometry" />
        </mxCell>
        <mxCell id="bm-box" value="" style="rounded=1;fillColor=#E3F2FD;opacity=60;dashed=1;dashPattern=6 6;strokeColor=#1565C0;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="268" y="680" width="580" height="220" as="geometry" />
        </mxCell>
        <mxCell id="bm-icon" value="" style="shape=image;image=img/lib/azure2/app_services/App_Services.svg;aspect=fixed;imageWidth=28;imageHeight=28;" parent="1" vertex="1">
          <mxGeometry x="286" y="692" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="bm-hdr" value="&lt;b&gt;检索目标 · ByModel 只读库 App Service&lt;/b&gt;（无 HRW / 粘性）" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#0D47A1;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="322" y="692" width="510" height="28" as="geometry" />
        </mxCell>
        <mxCell id="bm-lib1" value="&lt;b&gt;车书库&lt;/b&gt;&#xa;UserManual（FAISS）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=12;fontColor=#0D47A1;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="296" y="738" width="255" height="72" as="geometry" />
        </mxCell>
        <mxCell id="bm-lib2" value="&lt;b&gt;QA 库&lt;/b&gt;&#xa;QnA（FAISS）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=12;fontColor=#0D47A1;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="566" y="738" width="255" height="72" as="geometry" />
        </mxCell>
        <mxCell id="bm-note" value="离线建库经 Blob 只读同步下来；权威内容源，运行时只读、不承载缓存。" style="text;html=1;fontSize=10.5;align=left;spacingLeft=8;whiteSpace=wrap;fontColor=#37474F;" parent="1" vertex="1">
          <mxGeometry x="296" y="822" width="525" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bd-box" value="" style="rounded=1;fillColor=#FFF3E0;opacity=55;dashed=1;dashPattern=6 6;strokeColor=#CC6600;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="868" y="680" width="580" height="220" as="geometry" />
        </mxCell>
        <mxCell id="bd-icon" value="" style="shape=image;image=img/lib/azure2/app_services/App_Services.svg;aspect=fixed;imageWidth=28;imageHeight=28;" parent="1" vertex="1">
          <mxGeometry x="886" y="692" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="bd-hdr" value="&lt;b&gt;检索目标 · ByDevice 有状态库 App Service&lt;/b&gt;（pool，N 实例）" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#BF360C;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="922" y="692" width="510" height="28" as="geometry" />
        </mxCell>
        <mxCell id="bd-lib" value="&lt;b&gt;长尾偏好库&lt;/b&gt;　long-tail-pref&#xa;（每 device 一份 persist）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CC6600;fontSize=12;fontColor=#BF360C;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">
          <mxGeometry x="896" y="738" width="525" height="72" as="geometry" />
        </mxCell>
        <mxCell id="bd-note" value="同一 deviceId 经 HRW + Affinity 落固定 instance；写路径 persist 落盘 → 推回 Blob（source of truth）。" style="text;html=1;fontSize=10.5;fillColor=#FFEBEE;strokeColor=#EF5350;rounded=1;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;fontColor=#B71C1C;" parent="1" vertex="1">
          <mxGeometry x="896" y="822" width="525" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ais-box" value="" style="rounded=1;fillColor=#FCE4EC;opacity=55;dashed=1;dashPattern=6 6;strokeColor=#C2185B;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="260" y="980" width="900" height="330" as="geometry" />
        </mxCell>
        <mxCell id="ais-hdr" value="&lt;b&gt;检索目标 · 语义缓存（Azure AI Search）&lt;/b&gt;　与车书/QA、长尾偏好并列" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#880E4F;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="314" y="992" width="700" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ais-lib1" value="&lt;b&gt;bymodel-cache&lt;/b&gt;&#xa;车型维度缓存条目（按车型共享）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2185B;fontSize=12;fontColor=#880E4F;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=4 4;" parent="1" vertex="1">
          <mxGeometry x="288" y="1038" width="410" height="66" as="geometry" />
        </mxCell>
        <mxCell id="ais-lib2" value="&lt;b&gt;bydevice-cache&lt;/b&gt;&#xa;device 维度缓存条目（按 device）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2185B;fontSize=12;fontColor=#880E4F;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=4 4;" parent="1" vertex="1">
          <mxGeometry x="718" y="1038" width="410" height="66" as="geometry" />
        </mxCell>
        <mxCell id="ais-content" value="&lt;b&gt;内容独立自成一类&lt;/b&gt;　缓存条目不是从车书/QA/长尾库查出来再复制（那样无意义），而是它自身承载的一类内容（如高频直答、预置问答对等）。" style="text;html=1;fontSize=10.5;fillColor=#FFF0F5;strokeColor=#E091B4;rounded=1;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;fontColor=#880E4F;" parent="1" vertex="1">
          <mxGeometry x="288" y="1114" width="840" height="46" as="geometry" />
        </mxCell>
        <mxCell id="ais-info" value="&lt;b&gt;缓存键&lt;/b&gt;　向量近似匹配（cosine ≥ 阈值）+ 分区(customer/车型/lang/type/modelVersion)&#xa;&lt;b&gt;保存&lt;/b&gt;　结果写回，打 expiresAt 时间戳（bymodel 长 / bydevice 短）&#xa;&lt;b&gt;过期&lt;/b&gt;　查询按 expiresAt 过滤实现逻辑过期；另需定时任务物理清理（AI Search 无原生 TTL）" style="text;html=1;fontSize=10.5;fillColor=#F5F5F5;strokeColor=#BBBBBB;rounded=1;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;fontColor=#37474F;" parent="1" vertex="1">
          <mxGeometry x="288" y="1170" width="840" height="126" as="geometry" />
        </mxCell>
        <mxCell id="st-box" value="" style="rounded=1;fillColor=#E8EAF6;opacity=55;dashed=1;dashPattern=6 6;strokeColor=#3949AB;" parent="1" connectable="0" vertex="1">
          <mxGeometry x="1190" y="980" width="250" height="330" as="geometry" />
        </mxCell>
        <mxCell id="st-icon" value="" style="shape=image;image=img/lib/azure2/storage/Storage_Accounts.svg;aspect=fixed;imageWidth=28;imageHeight=28;" parent="1" vertex="1">
          <mxGeometry x="1208" y="992" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="st-hdr" value="&lt;b&gt;Storage Account&lt;/b&gt;" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#1A237E;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1244" y="992" width="180" height="28" as="geometry" />
        </mxCell>

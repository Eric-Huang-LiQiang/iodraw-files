          <mxGeometry x="886" y="692" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="bd-hdr" value="&lt;b&gt;检索目标 · ByDevice 有状态库 App Service&lt;/b&gt;（pool，N 实例）" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#BF360C;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="922" y="692" width="510" height="28" as="geometry" />
        </mxCell>
        <mxCell id="bd-lib" value="&lt;b&gt;长尾偏好库&lt;/b&gt;　long-tail-pref&#xa;（每 device 一份 persist）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CC6600;fontSize=12;fontColor=#BF360C;verticalAlign=top;spacingTop=8;" parent="1" vertex="1">

          <mxGeometry x="260" y="440" width="1180" height="150" as="geometry" />
        </mxCell>
        <mxCell id="yFy1p2oUVh9DSKfpmP5x-20" value="&lt;b&gt;改写服务 App Service&lt;/b&gt;（无状态 · 可横向扩）" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#1B5E20;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="312" y="452" width="400" height="26" as="geometry" />
        </mxCell>
        <mxCell id="yFy1p2oUVh9DSKfpmP5x-21" value="多轮改写 rewrite&#xa;(query, 上下文)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#43A047;fontSize=11.5;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="290" y="490" width="200" height="52" as="geometry" />

        <mxCell id="yFy1p2oUVh9DSKfpmP5x-38" value="&lt;b&gt;bymodel-cache&lt;/b&gt;&#xa;车型维度缓存条目（按车型共享）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2185B;fontSize=12;fontColor=#880E4F;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=4 4;" vertex="1" parent="1">

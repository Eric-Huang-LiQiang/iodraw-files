        <mxCell id="yFy1p2oUVh9DSKfpmP5x-22" value="向量化 embed → q&#xa;（带 modelVersion）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#43A047;fontSize=11.5;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="520" y="490" width="200" height="52" as="geometry" />
        </mxCell>
        <mxCell id="yFy1p2oUVh9DSKfpmP5x-23" value="改写 + 向量化供全部检索目标复用；embedding 模型只在此常驻，Gateway 保持轻量。" style="text;html=1;fontSize=10.5;align=left;spacingLeft=8;whiteSpace=wrap;fontColor=#2E7D32;verticalAlign=middle;" vertex="1" parent="1">

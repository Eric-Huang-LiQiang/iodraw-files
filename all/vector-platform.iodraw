        </mxCell>
        <mxCell id="yFy1p2oUVh9DSKfpmP5x-39" value="&lt;b&gt;bydevice-cache&lt;/b&gt;&#xa;device 维度缓存条目（按 device）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2185B;fontSize=12;fontColor=#880E4F;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=4 4;" vertex="1" parent="1">
          <mxGeometry x="718" y="1038" width="410" height="66" as="geometry" />

        <mxCell id="yFy1p2oUVh9DSKfpmP5x-34" value="&lt;b&gt;长尾偏好库&lt;/b&gt;　long-tail-pref&#xa;（每 device 一份 persist）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CC6600;fontSize=12;fontColor=#BF360C;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">

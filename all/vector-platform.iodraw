        <mxCell id="bd-note" value="同一 deviceId 经 HRW + Affinity 落固定 instance；写路径 persist 落盘 → 推回 Blob（source of truth）。" style="text;html=1;fontSize=10.5;fillColor=#FFEBEE;strokeColor=#EF5350;rounded=1;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;fontColor=#B71C1C;" parent="1" vertex="1">

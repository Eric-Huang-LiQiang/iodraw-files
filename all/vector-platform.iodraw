        <mxCell id="yFy1p2oUVh9DSKfpmP5x-10" value="" style="shape=image;image=img/lib/azure2/app_services/App_Services.svg;aspect=fixed;imageWidth=28;imageHeight=28;" vertex="1" parent="1">
          <mxGeometry x="268" y="112" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="yFy1p2oUVh9DSKfpmP5x-11" value="&lt;b&gt;Vector Gateway&lt;/b&gt;　查询/更新统一入口 · 编排层（无状态，可横向扩）" style="text;html=1;fontSize=13.5;fontStyle=1;fontColor=#4527A0;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="300" y="112" width="604" height="28" as="geometry" />
        </mxCell>
        <mxCell id="yFy1p2oUVh9DSKfpmP5x-12" value="①　统一入口&#xa;/vector　query + update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E57C2;fontSize=12;fontColor=#311B92;" vertex="1" parent="1">
          <mxGeometry x="280" y="158" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="yFy1p2oUVh9DSKfpmP5x-13" value="②　调改写服务&#xa;→ 改写后 query" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E57C2;fontSize=12;fontColor=#311B92;" vertex="1" parent="1">
          <mxGeometry x="510" y="158" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="yFy1p2oUVh9DSKfpmP5x-14" value="③　向量化&#xa;→ query 向量 q" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E57C2;fontSize=12;fontColor=#311B92;" vertex="1" parent="1">
          <mxGeometry x="720" y="158" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="yFy1p2oUVh9DSKfpmP5x-15" value="④　按 type 路由到检索目标&#xa;（透传 q，后端不再 embed）&#xa;车书/QA｜长尾偏好｜语义缓存 三类并列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E57C2;fontSize=12;fontColor=#311B92;" vertex="1" parent="1">
          <mxGeometry x="930" y="158" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="yFy1p2oUVh9DSKfpmP5x-16" value="&lt;b&gt;HRW&lt;/b&gt;　key=deviceId · N 选一（抖动 1/N）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#CC6600;fontSize=11;fontColor=#BF360C;" vertex="1" parent="1">
          <mxGeometry x="1190" y="158" width="220" height="28" as="geometry" />
        </mxCell>
        <mxCell id="yFy1p2oUVh9DSKfpmP5x-17" value="&lt;b&gt;Session Affinity&lt;/b&gt;　钉 deviceId 到固定 instance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#CC6600;fontSize=11;fontColor=#BF360C;" vertex="1" parent="1">
          <mxGeometry x="1190" y="190" width="220" height="28" as="geometry" />
        </mxCell>
        <mxCell id="yFy1p2oUVh9DSKfpmP5x-18" value="只读库（车书/QA）数据库配置 URL，任意副本轮询，不走 HRW。语义缓存是与车书/QA、长尾偏好并列的一类检索目标 —— 命中与否不改变其它目标的调用（不是前置短路）；仅长尾偏好走 HRW + Session Affinity。" style="text;html=1;fontSize=10.5;fillColor=#F3E5F5;strokeColor=#CE93D8;rounded=1;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;fontColor=#6A1B9A;" vertex="1" parent="1">
          <mxGeometry x="280" y="240" width="1130" height="80" as="geometry" />
        </mxCell>

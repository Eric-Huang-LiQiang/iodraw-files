        </mxCell>
        <mxCell id="yFy1p2oUVh9DSKfpmP5x-5" value="向量平台架构 · Vector Gateway 统一编排（车书/QA · 长尾偏好 · 语义缓存 三类并列检索目标）" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#FFFFFF;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="1300" height="32" as="geometry" />
        </mxCell>
        <mxCell id="yFy1p2oUVh9DSKfpmP5x-6" value="Gateway：改写 → 向量化 → 按 type 路由到检索目标；语义缓存与车书/QA、长尾偏好并列（不是前置短路），存 AI Search，内容独立自成一类" style="text;html=1;fontSize=12;fontColor=#C5CAE9;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="32" y="44" width="1400" height="22" as="geometry" />
        </mxCell>
        <mxCell id="yFy1p2oUVh9DSKfpmP5x-7" value="&lt;b&gt;Client&lt;/b&gt;&#xa;query · update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;fontSize=13;fontColor=#263238;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="yFy1p2oUVh9DSKfpmP5x-8" value="&lt;b&gt;入参&lt;/b&gt;&#xa;customer · deviceModel&#xa;language · deviceId · type" style="text;html=1;fontSize=10;fillColor=#F5F5F5;strokeColor=#CCCCCC;rounded=1;align=left;spacingLeft=8;spacingTop=4;whiteSpace=wrap;fontColor=#455A64;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="150" height="66" as="geometry" />
        </mxCell>
        <mxCell id="yFy1p2oUVh9DSKfpmP5x-9" value="" style="rounded=1;fillColor=#EDE7F6;opacity=60;dashed=1;dashPattern=6 6;strokeColor=#5E35B1;" vertex="1" connectable="0" parent="1">
          <mxGeometry x="250" y="100" width="1180" height="240" as="geometry" />

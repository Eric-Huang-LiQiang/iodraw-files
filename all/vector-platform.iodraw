        <mxCell id="ais-hdr" value="&lt;b&gt;检索目标 · 语义缓存（Azure AI Search）&lt;/b&gt;　与车书/QA、长尾偏好并列" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#880E4F;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="314" y="992" width="700" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ais-lib1" value="&lt;b&gt;bymodel-cache&lt;/b&gt;&#xa;车型维度缓存条目（按车型共享）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2185B;fontSize=12;fontColor=#880E4F;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=4 4;" parent="1" vertex="1">
          <mxGeometry x="288" y="1038" width="410" height="66" as="geometry" />
        </mxCell>
        <mxCell id="ais-lib2" value="&lt;b&gt;bydevice-cache&lt;/b&gt;&#xa;device 维度缓存条目（按 device）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C2185B;fontSize=12;fontColor=#880E4F;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=4 4;" parent="1" vertex="1">
          <mxGeometry x="718" y="1038" width="410" height="66" as="geometry" />
        </mxCell>
        <mxCell id="ais-content" value="&lt;b&gt;内容独立自成一类&lt;/b&gt;　缓存条目不是从车书/QA/长尾库查出来再复制（那样无意义），而是它自身承载的一类内容（如高频直答、预置问答对等）。" style="text;html=1;fontSize=10.5;fillColor=#FFF0F5;strokeColor=#E091B4;rounded=1;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;fontColor=#880E4F;" parent="1" vertex="1">
          <mxGeometry x="288" y="1114" width="840" height="46" as="geometry" />
        </mxCell>
        <mxCell id="ais-info" value="&lt;b&gt;缓存键&lt;/b&gt;　向量近似匹配（cosine ≥ 阈值）+ 分区(customer/车型/lang/type/modelVersion)&#xa;&lt;b&gt;保存&lt;/b&gt;　结果写回，打 expiresAt 时间戳（bymodel 长 / bydevice 短）&#xa;&lt;b&gt;过期&lt;/b&gt;　查询按 expiresAt 过滤实现逻辑过期；另需定时任务物理清理（AI Search 无原生 TTL）" style="text;html=1;fontSize=10.5;fillColor=#F5F5F5;strokeColor=#BBBBBB;rounded=1;align=left;spacingLeft=8;spacingTop=6;whiteSpace=wrap;fontColor=#37474F;" parent="1" vertex="1">

          <mxGeometry x="520" y="490" width="200" height="52" as="geometry" />
        </mxCell>
        <mxCell id="rw-note" value="改写 + 向量化供全部检索目标复用；embedding 模型只在此常驻，Gateway 保持轻量。" style="text;html=1;fontSize=10.5;align=left;spacingLeft=8;whiteSpace=wrap;fontColor=#2E7D32;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="750" y="490" width="670" height="52" as="geometry" />
        </mxCell>
        <mxCell id="rw-note2" value="改写+向量化算出的 q，透传给下方三类检索目标；后端不再 embed。" style="text;html=1;fontSize=10;align=left;spacingLeft=8;whiteSpace=wrap;fontColor=#2E7D32;" parent="1" vertex="1">
          <mxGeometry x="290" y="552" width="1130" height="28" as="geometry" />
        </mxCell>

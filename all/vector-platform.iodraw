        <mxCell id="rw1" value="多轮改写 rewrite&#xa;(query, 上下文)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#43A047;fontSize=11.5;fontColor=#1B5E20;" parent="1" vertex="1">
          <mxGeometry x="290" y="490" width="200" height="52" as="geometry" />

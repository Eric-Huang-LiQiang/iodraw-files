        <mxCell id="yFy1p2oUVh9DSKfpmP5x-33" value="&lt;b&gt;检索目标 · ByDevice 有状态库 App Service&lt;/b&gt;（pool，N 实例）" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#BF360C;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="922" y="692" width="510" height="28" as="geometry" />

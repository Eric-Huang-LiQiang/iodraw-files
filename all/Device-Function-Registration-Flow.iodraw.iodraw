<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) ioDraw.com/3.6.1 Chrome/124.0.6367.49 Electron/30.0.0 Safari/537.36" version="24.7.17">
  <diagram id="flow" name="注册与匹配">
    <mxGraphModel dx="1693" dy="1029" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="2420" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;车机 Function：注册时怎么更新数据库和向量库，匹配时怎么筛选比对范围&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=26;fontColor=#111827;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="30" y="14" width="2400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="&lt;b&gt;一、注册：车机提交全量 MCP 后，数据库和向量库怎么更新&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=22;fontColor=#1D6FD8;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="30" y="68" width="2400" height="34" as="geometry" />
        </mxCell>
        <mxCell id="t1s" value="以 function 名字（忽略大小写）为依据，和这台车当前的注册逐个比较；一个事务写数据库，提交后调站点实时更新“语言 + 车企 + 车型”这个向量库，站点后台整库上传 Blob。SQL 是唯一可信数据。" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#4B5563;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="30" y="108" width="2440" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r-la" value="" style="rounded=1;arcSize=2;html=1;fillColor=#EDF4FD;strokeColor=#1D6FD8;dashed=1;dashPattern=8 4;strokeWidth=1.5;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="30" y="160" width="1670" height="1100" as="geometry" />
        </mxCell>
        <mxCell id="r-la-title" value="&lt;b&gt;车机 → 设备网关 → 向量服务：比对并写数据库（同一个事务）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#1D6FD8;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="46" y="170" width="1638" height="28" as="geometry" />
        </mxCell>
        <mxCell id="r-lb" value="" style="rounded=1;arcSize=2;html=1;fillColor=#F3EEFB;strokeColor=#7A4FC4;dashed=1;dashPattern=8 4;strokeWidth=1.5;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="1740" y="160" width="730" height="1100" as="geometry" />
        </mxCell>
        <mxCell id="r-lb-title" value="&lt;b&gt;语义检索站点：更新向量库（一个 语言 + 车企 + 车型 一个库）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#7A4FC4;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="1756" y="170" width="698" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="① 车机提交全量 MCP&lt;br&gt;请求头：customer、DeviceId、DeviceModel、Language" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#6B7280;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="60" y="210" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="② 设备网关：api-key 解密须等于 DeviceId，转发向量服务" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#6B7280;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="60" y="310" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="车企、车型、语言&lt;br&gt;是否不为空" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B45309;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="60" y="400" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="返回 400" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF3F2;strokeColor=#B42318;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="400" y="425" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="解析 MCP：名字须 ^[A-Za-z0-9_.-]{1,128}$，描述非空且不超过 4000 字；同一请求重名只留第一个；不合格的记入 skipped" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6FD8;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="60" y="530" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="超过 200 个？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B45309;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="60" y="650" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="返回 413" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF3F2;strokeColor=#B42318;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="400" y="670" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="③ 开事务；读这台车当前的有效映射，&lt;br&gt;连工具行得到“名字 → 工具行”" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6FD8;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="60" y="770" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;逐个处理这次提交的名字（忽略大小写）&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6FD8;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="60" y="880" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="同车企 + 车型 + 语言&lt;br&gt;名字相同的注册行？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B45309;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="600" y="210" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="描述相同？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B45309;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="920" y="210" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="k1" value="不动 → 下一个名字" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#6B7280;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="920" y="340" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="u1" value="&lt;b&gt;就地更新&lt;/b&gt;工具行 + 函数行：描述、Value、Updated&lt;br&gt;记入“描述变了” → 下一个名字" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF6EF;strokeColor=#1D6FD8;strokeWidth=2.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="920" y="420" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="device id 是否相同" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B45309;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="600" y="570" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="复用这一行" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6FD8;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="920" y="600" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="新建函数行 + 工具行&lt;br&gt;PromptTemplateId 空，Locale = Language" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6FD8;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="600" y="730" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d6" value="这台车有这个工具的&lt;br&gt;已删除映射？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B45309;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="920" y="710" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="恢复映射" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6FD8;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="920" y="870" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="新增映射" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6FD8;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="1060" y="870" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="记入“新增” → 下一个名字" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF6EF;strokeColor=#1D6FD8;strokeWidth=2.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="920" y="960" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="④ 这台车有、这次没提交的名字：&lt;br&gt;&lt;b&gt;软删除映射&lt;/b&gt;，记入“可能不再引用”" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF6EF;strokeColor=#1D6FD8;strokeWidth=2.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="1280" y="210" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;⑤ 提交事务&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6FD8;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="1280" y="330" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d7" value="有新增 / 描述变了 /&lt;br&gt;可能不再引用？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B45309;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="1300" y="410" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="nt" value="⑥ 查路由：先 (车企, 车型, 语言)，再 (车企, &#39;&#39;, 语言)&lt;br&gt;调该站点 /library/update，带上三类工具 Id&lt;br&gt;调用失败只记日志，不影响注册结果" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6FD8;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="1280" y="560" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ret" value="⑦ 返回 registered、unchanged、skipped&lt;br&gt;（不等 Blob 上传）" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#6B7280;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="1280" y="710" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nt3" value="&lt;b&gt;三类工具 Id&lt;/b&gt;&lt;br&gt;新增：新建或复用后、新加或恢复了映射的&lt;br&gt;描述变了：就地更新的&lt;br&gt;可能不再引用：这台车刚软删除映射的。别的车可能还在用，由站点判断要不要删向量" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#CCCCCC;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="1280" y="820" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="nta" value="&lt;b&gt;不碰的东西&lt;/b&gt;&lt;br&gt;通用 function（挂在 LLM 代理模板下的 27 行）注册全程不读不写。&lt;br&gt;复用查找只在同车企 + 车型 + 语言的注册行里找：名字按库的排序规则忽略大小写，描述按二进制严格比较。" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#CCCCCC;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="60" y="1090" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ntb" value="&lt;b&gt;就地更新的代价&lt;/b&gt;&lt;br&gt;同车企 + 车型 + 语言里共用这一行的车，描述一起变，以最后一次注册为准。&lt;br&gt;一台车同一个名字只有一条有效映射，由注册代码在事务里保证。" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#CCCCCC;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="600" y="1090" width="580" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="收到 /library/update：语言、车企、车型 + 三类工具 Id" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A4FC4;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="1780" y="210" width="650" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="这个库已在&lt;br&gt;内存里？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B45309;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="1780" y="300" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b2n" value="从 Blob 下载；Blob 没有就按 SQL 建&lt;br&gt;（通用 function，Locale = 语言）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A4FC4;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="2120" y="315" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="新增、描述变了的工具 Id：读工具行 → 调 embedding 算描述向量 → 拿写锁加入库，或替换旧向量" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3EEFB;strokeColor=#7A4FC4;strokeWidth=2.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="1780" y="440" width="650" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="可能不再引用的工具 Id：&lt;br&gt;本库还有有效映射&lt;br&gt;引用它？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B45309;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="1780" y="550" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b4y" value="保留向量" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A4FC4;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="2180" y="580" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="拿写锁从库里删掉这条向量" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3EEFB;strokeColor=#7A4FC4;strokeWidth=2.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="1780" y="710" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="标记“待上传”，接口返回（注册不等上传）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A4FC4;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="1780" y="810" width="650" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b7" value="后台上传线程：整库上传到&lt;br&gt;vector/semanticsearch/{语言}/{车企}/{车型}/vectorDatabase/&lt;br&gt;连续多次变化合并成一次，只传最新版本；失败重试；目录不存在自动创建" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A4FC4;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="1780" y="900" width="650" height="100" as="geometry" />
        </mxCell>
        <mxCell id="bn" value="&lt;b&gt;失败了怎么办&lt;/b&gt;&lt;br&gt;SQL 是唯一可信数据：站点调用失败、上传 Blob 失败都不丢数据。&lt;br&gt;站点重启时从 Blob 下载库，再和 SQL 比对：缺的、Updated 对不上的重算，不再被引用的删掉。&lt;br&gt;检索时发现缺向量或 Updated 对不上，也会当场补（见下方“二、匹配”）。" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#CCCCCC;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="1780" y="1030" width="650" height="120" as="geometry" />
        </mxCell>
        <mxCell id="x1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#374151;fontColor=#374151;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="c1" target="c2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="x2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#374151;fontColor=#374151;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="c2" target="c3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="x3" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#B42318;fontColor=#B42318;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="c3" target="e1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="x4" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#374151;fontColor=#374151;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="c3" target="c4" edge="1">

        </mxCell>
        <mxCell id="q-s1" value="选库：语言 + 车企 + 车型&lt;br&gt;不在内存就从 Blob 下载，Blob 没有就按 SQL 建（只有通用 function）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A4FC4;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="780" y="1460" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="q-s2" value="Ⓒ 查这台车的注册（每次检索一次，走索引）&lt;br&gt;SELECT t.Id, t.Name, t.Updated FROM 映射表 m JOIN 工具行 t&lt;br&gt;WHERE m.Customer, m.DeviceId, m.Deleted = 0, t.Locale = 语言 → &lt;b&gt;注册集合 R&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A4FC4;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="780" y="1560" width="560" height="100" as="geometry" />
        </mxCell>
        <mxCell id="q-s3" value="R 的每个 Id 都在库里，&lt;br&gt;且 Updated 一致？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B45309;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="860" y="1690" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="q-s3n" value="补缺：只为缺的、Updated 对不上的算向量，&lt;br&gt;写锁加入或替换，排一次上传" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A4FC4;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="1380" y="1710" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="q-s4" value="通用集合 G = 库里的通用 function&lt;br&gt;（挂在 LLM 代理模板下，Locale = 语言）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A4FC4;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="780" y="1830" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="q-s5" value="同名覆盖：从 G 去掉名字和 R 里同名的（忽略大小写）→ G&#39;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A4FC4;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="780" y="1930" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="q-s6" value="&lt;b&gt;Ⓓ 比对范围 A = R ∪ G&#39;&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF6EF;strokeColor=#1E8E5A;strokeWidth=2.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="780" y="2030" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="q-s7" value="FAISS 只在 A 里检索：问句向量和描述向量算内积，取前 topK" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A4FC4;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="780" y="2130" width="560" height="60" as="geometry" />
        </mxCell>
        <mxCell id="q-s8" value="返回 name、description、score、toolId" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A4FC4;strokeWidth=1.5;fontSize=12;fontColor=#1F2937;align=center;verticalAlign=middle;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="780" y="2220" width="560" height="60" as="geometry" />
        </mxCell>
        <mxCell id="q-ex1" value="&lt;b&gt;例：rox / mce / en-US 这个库&lt;/b&gt;&lt;br&gt;&lt;br&gt;车 A 注册了 AC、climate_fan_speed：&lt;br&gt;R = {注册的 AC, climate_fan_speed}&lt;br&gt;G&#39; = 通用 27 个去掉通用 AC = 26 个&lt;br&gt;A = 28 个，比对时只用注册的 AC 描述&lt;br&gt;&lt;br&gt;车 B 没注册：R 为空，A = 通用 27 个（和现在一样）&lt;br&gt;&lt;br&gt;车 C 注册了 climate_ac：名字不同，不覆盖通用 AC，两条都参与比对&lt;br&gt;&lt;br&gt;车 A 切到 de-DE：选的是 de-DE 的库，t.Locale = de-DE，en-US 注册的工具不参与" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#CCCCCC;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="1940" y="1410" width="530" height="260" as="geometry" />
        </mxCell>
        <mxCell id="q-ex2" value="&lt;b&gt;不在比对范围内的&lt;/b&gt;&lt;br&gt;别的车注册的工具，即使在同一个库里&lt;br&gt;别的语言、别的车企、别的车型的工具（不在这个库）&lt;br&gt;被这台车同名覆盖的通用 function&lt;br&gt;这台车已软删除映射的工具" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#CCCCCC;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="1940" y="1700" width="530" height="140" as="geometry" />
        </mxCell>
        <mxCell id="q-ex3" value="&lt;b&gt;为什么“车辆 → 工具”每次查库、不缓存&lt;/b&gt;&lt;br&gt;按每台车 20 个工具估，10 万台车约 150 MB、100 万台约 1.5 GB，随车辆数线性增长。&lt;br&gt;向量库只跟工具行数量有关：一条 12 KB，1 万条约 0.11 GB。&lt;br&gt;本机实测：5027 条里按 Id 过滤检索 1.4 ms。" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#CCCCCC;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="1940" y="1870" width="530" height="140" as="geometry" />
        </mxCell>
        <mxCell id="q-z1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#374151;fontColor=#374151;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="q-a1" target="q-a2" edge="1">
          <mxGeometry relative="1" as="geometry" />

<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) ioDraw.com/3.6.1 Chrome/124.0.6367.49 Electron/30.0.0 Safari/537.36" version="24.7.17">
  <diagram id="flow" name="注册与匹配">
    <mxGraphModel dx="2708" dy="1646" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="3630" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;MCP Tool 注册和匹配流程图&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=28;fontColor=#111827;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="30" width="2440" height="54" as="geometry" />
        </mxCell>
        <mxCell id="h1" value="&lt;b&gt;一、注册&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=22;fontColor=#1D6FD8;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="30" y="64" width="2440" height="32" as="geometry" />
        </mxCell>
        <mxCell id="h1s" value="以 function name 为依据，和这台车的对照表逐个比较；④ ~ ⑨ 在同一个数据库事务里。数据库和站点的向量库都写好才算注册成功：站点写入成功后才提交，失败就回滚。Blob 由站点后台上传，注册不等。" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#4B5563;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="30" y="100" width="2440" height="26" as="geometry" />
        </mxCell>
        <mxCell id="lane-a" value="" style="rounded=1;arcSize=2;html=1;fillColor=#EDF4FD;strokeColor=#1D6FD8;dashed=1;dashPattern=8 4;strokeWidth=1.5;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="30" y="140" width="1680" height="2320" as="geometry" />
        </mxCell>
        <mxCell id="lane-a-title" value="&lt;b&gt;车机 → 设备网关 → 向量服务：比对并写数据库&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#1D6FD8;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="46" y="150" width="1648" height="28" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="① 车机提交全量 MCP&lt;br&gt;请求头：customer、DeviceId、DeviceModel、Language" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#6B7280;strokeWidth=1.5;fontSize=15;fontColor=#111827;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="590" y="180" width="560" height="64" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="② 设备网关：api-key 鉴权后，转发向量服务" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#6B7280;strokeWidth=1.5;fontSize=15;fontColor=#111827;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="640" y="268" width="460" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="车企、车型、语言&lt;br&gt;是否不为空？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#B45309;strokeWidth=1.5;fontSize=15;fontColor=#111827;spacing=2;" parent="1" vertex="1">
          <mxGeometry x="700" y="348" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n3e" value="返回 400" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEF3F2;strokeColor=#B42318;strokeWidth=1.5;fontSize=15;fontColor=#111827;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="1100" y="378" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="③ 解析 MCP：不合格的跳过，记入 skipped；&lt;br&gt;同一请求里同名的只留第一个" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6FD8;strokeWidth=1.5;fontSize=15;fontColor=#111827;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="640" y="486" width="460" height="64" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="④ 开事务，按 车企 + 车型 + 语言 加锁（同时注册的车排队）&lt;br&gt;查一次库，读出两张对照表（之后只查内存）：&lt;br&gt;&lt;b&gt;这台车的&lt;/b&gt;：有效 mapping 连工具行，按 function name 找&lt;br&gt;&lt;b&gt;共用的&lt;/b&gt;：同车企 + 车型 + 语言所有车用过的工具行（软删除的&lt;br&gt;mapping 也算），按 function name + 描述找，带上还有没有车在用" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6FD8;strokeWidth=1.5;fontSize=15;fontColor=#111827;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="590" y="576" width="560" height="140" as="geometry" />
        </mxCell>
        <mxCell id="na1" value="&lt;b&gt;mapping 和两张对照表&lt;/b&gt;&lt;br&gt;mapping：映射表 [Device].[DeviceToolMapping] 的一行，表示这台车用哪一行工具。&lt;br&gt;这台车的对照表：只看这台车，软删除的 mapping 不算。&lt;br&gt;共用对照表：同车企 + 车型 + 语言的所有车，软删除的 mapping 也算。工具行上没有车企、车型，只有 mapping 记着它属于谁；不算的话，没车再用的行就找不到，会重复建一样的行。&lt;br&gt;比较：function name 忽略大小写，描述逐字符严格比较。&lt;br&gt;参数：inputSchema 拆进参数行、属性行（和通用 function 一样）；取值范围、默认值、数组元素、嵌套对象存不下，只留在 Value。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#CCCCCC;fontSize=14;fontColor=#333333;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="70" y="180" width="480" height="250" as="geometry" />
        </mxCell>
        <mxCell id="na2" value="通用 function（挂在 LLM 代理模板下的 27 行）：不参与注册过程的匹配。&lt;br&gt;注册流程只新建或就地更新工具行；不删工具行，也不删向量。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#CCCCCC;fontSize=14;fontColor=#333333;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="1270" y="180" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#374151;fontColor=#374151;strokeWidth=2;fontSize=14;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="n1" target="n2" edge="1">
          <mxGeometry relative="1" as="geometry" />

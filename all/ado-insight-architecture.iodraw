  <diagram id="ai" name="AI 场景闭环">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1030" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;ADO 项目洞察 · AI 场景闭环&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=24;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="18" width="1400" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="&lt;b&gt;亮点：AI 把“售前估算 → 交付执行 → 复盘”这条原本断开的链路接了起来&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=14;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="54" width="1820" height="20" as="geometry" />
        </mxCell>
        <mxCell id="criteria" value="筛选标准：输入是自由文字、或要跨项目按意思匹配，才用 AI（结构化数字交给代码）　·　有人拿输出去做事　·　AI 出错时人能很快发现　·　价值能量化" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#6B7280;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="76" width="1820" height="18" as="geometry" />
        </mxCell>
        <mxCell id="col-pre" value="" style="rounded=1;arcSize=2;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;dashPattern=8 4;strokeWidth=1.5;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="30" y="128" width="350" height="472" as="geometry" />
        </mxCell>
        <mxCell id="col-del" value="" style="rounded=1;arcSize=2;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;dashPattern=8 4;strokeWidth=1.5;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="430" y="128" width="1020" height="472" as="geometry" />
        </mxCell>
        <mxCell id="col-post" value="" style="rounded=1;arcSize=2;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;dashPattern=8 4;strokeWidth=1.5;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="1500" y="128" width="350" height="472" as="geometry" />
        </mxCell>
        <mxCell id="st-pre" value="&lt;b&gt;售前 · 估算&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:12px&#39; color=&#39;#CBD5E1&#39;&gt;报价前参考历史偏差&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=none;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="128" width="350" height="52" as="geometry" />
        </mxCell>
        <mxCell id="st-del" value="&lt;b&gt;交付 · 执行&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:12px&#39; color=&#39;#CBD5E1&#39;&gt;起草周报、预警风险、识别阻塞和范围变更&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=none;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="128" width="1020" height="52" as="geometry" />
        </mxCell>
        <mxCell id="st-post" value="&lt;b&gt;复盘 · 写回&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:12px&#39; color=&#39;#CBD5E1&#39;&gt;实际结果写回估算偏差库&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=none;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1500" y="128" width="350" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e-pre-del" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#334155;fontColor=#334155;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="st-pre" target="st-del">
          <mxGeometry x="0" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-del-post" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#334155;fontColor=#334155;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="st-del" target="st-post">
          <mxGeometry x="0" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-loop" value="闭环：实际结果写回估算偏差库，下次报价更准" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeColor=#334155;fontColor=#334155;strokeWidth=2.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="st-post" target="st-pre">
          <mxGeometry x="0" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1675" y="108" />
              <mxPoint x="205" y="108" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c5a" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A4FC4;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="46" y="196" width="318" height="170" as="geometry" />
        </mxCell>
        <mxCell id="c5a-title" value="&lt;b&gt;⑤ 估算偏差提示&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;第二批 · 售前、架构师&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c5a">
          <mxGeometry x="12" y="8" width="296" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c5a-body" value="做新项目的 DRM 估算时，&lt;br&gt;自动提示相似模块的历史偏差&lt;br&gt;例：“数据迁移类模块，过去 6 个项目&lt;br&gt;　　实际比估算平均多出 40%”&lt;br&gt;前提：DRM 结果先存进数据库" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c5a">
          <mxGeometry x="12" y="58" width="294" height="106" as="geometry" />
        </mxCell>
        <mxCell id="n-urs" value="&lt;b&gt;售前进展分析（扩展方向）&lt;/b&gt;&lt;br&gt;URS 要求“用 AI 分析每个售前项目的进展”，目前是规则实现。场景 ② 的“证据包 → AI 判断 → 核对引用”可以直接复用，数据来源换成售前的 SharePoint 文件夹。" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="46" y="382" width="318" height="116" as="geometry" />
        </mxCell>
        <mxCell id="gone6" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="46" y="514" width="318" height="66" as="geometry" />
        </mxCell>
        <mxCell id="gone6-title" value="&lt;b&gt;找相似项目和经验（原场景 6）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="gone6">
          <mxGeometry x="12" y="8" width="296" height="24" as="geometry" />
        </mxCell>
        <mxCell id="gone6-body" value="已有别的工具，不在本方案内" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="gone6">
          <mxGeometry x="12" y="38" width="294" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6FD8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="446" y="196" width="235" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c1-title" value="&lt;b&gt;① 周报和汇报起草&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;第一批 · PM&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="12" y="8" width="213" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c1-body" value="输入：本周变化的条目、Sprint、部署&lt;br&gt;输出：每句带 ADO 链接的草稿，&lt;br&gt;　　　PM 改完再发&lt;br&gt;衡量：采纳率、改动幅度、省时&lt;br&gt;&lt;b&gt;用户最容易感受到的场景&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c1">
          <mxGeometry x="12" y="58" width="211" height="116" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6FD8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="697" y="196" width="235" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c2-title" value="&lt;b&gt;② 风险预警和原因解释&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;第一批 · 交付经理、管理层&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c2">
          <mxGeometry x="12" y="8" width="213" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c2-body" value="代码算异常信号：速度下滑、&lt;br&gt;范围上涨、三种完成度对不上&lt;br&gt;AI 判断原因，写出该问 PM 的问题&lt;br&gt;&lt;b&gt;亮点：能用历史快照回测&lt;/b&gt;&lt;br&gt;衡量：命中率、提前几周、误报率" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c2">
          <mxGeometry x="12" y="58" width="211" height="116" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6FD8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="948" y="196" width="235" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c3-title" value="&lt;b&gt;③ 识别阻塞和客户依赖&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;第一批 · PM、交付经理&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c3">
          <mxGeometry x="12" y="8" width="213" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c3-body" value="输入：条目评论、PR 未解决的讨论&lt;br&gt;写法五花八门，关键词规则会漏&lt;br&gt;输出：阻塞清单，按客户、环境、&lt;br&gt;第三方、内部分类，附原文链接&lt;br&gt;价值：及时升级；谈延期的依据" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c3">
          <mxGeometry x="12" y="58" width="211" height="116" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A4FC4;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1199" y="196" width="235" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c4-title" value="&lt;b&gt;④ 固定总价项目范围变更&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;第二批 · &lt;b&gt;和钱关系最直接&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c4">
          <mxGeometry x="12" y="8" width="213" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c4-body" value="输入：基线后新建的需求 + SOW&lt;br&gt;判断是合同内细化还是合同外新增&lt;br&gt;输出：候选变更 + 最接近的条款，&lt;br&gt;由 PM 确认是否算变更&lt;br&gt;衡量：确认的变更数量和金额" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c4">
          <mxGeometry x="12" y="58" width="211" height="116" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="446" y="392" width="318" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c7-title" value="&lt;b&gt;⑦ 工时预测拒绝原因分析&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;拒绝记录攒够之后 · 资源经理&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c7">
          <mxGeometry x="12" y="8" width="296" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c7-body" value="拒绝原因归类：延期、提前结束、被调走、工时不对&lt;br&gt;说“项目已结束”但 ADO 仍在活跃开发 → 标出矛盾&lt;br&gt;ADO 推算要延期、之后排期却为 0 → 提示缺口&lt;br&gt;缺口由代码算，AI 写说明和建议" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c7">
          <mxGeometry x="12" y="58" width="294" height="116" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="780" y="392" width="318" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c8-title" value="&lt;b&gt;⑧ 新成员入项简报&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;第三批 · 新加入的成员&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c8">
          <mxGeometry x="12" y="8" width="296" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c8-body" value="触发：第一次出现在某项目的排期里&lt;br&gt;一页简报：项目背景、架构、当前阶段、&lt;br&gt;关键联系人、待解决问题、必读 wiki&lt;br&gt;排第三批：用得少，有经验的 PM 会交接" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c8">
          <mxGeometry x="12" y="58" width="294" height="116" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1114" y="392" width="318" height="180" as="geometry" />
        </mxCell>
        <mxCell id="c9-title" value="&lt;b&gt;⑨ 流水线失败原因归类&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;第三批 · 交付经理&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c9">
          <mxGeometry x="12" y="8" width="296" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c9-body" value="输入：失败任务的日志末尾（先过滤敏感信息）&lt;br&gt;归类：代码、测试不稳定、环境、证书、依赖&lt;br&gt;例：UAT 部署连续失败都是客户证书问题，&lt;br&gt;这本身就是客户依赖证据，汇入场景 ③" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c9">
          <mxGeometry x="12" y="58" width="294" height="116" as="geometry" />
        </mxCell>
        <mxCell id="c5b" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A4FC4;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1516" y="196" width="318" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c5b-title" value="&lt;b&gt;⑤ 估算偏差库&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;第二批 · 对应 URS 主线 presale → delivery&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c5b">
          <mxGeometry x="12" y="8" width="296" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c5b-body" value="DRM 模块叫“数据迁移”，ADO Feature 叫&lt;br&gt;“Legacy DB migration to Azure SQL”&lt;br&gt;两边各写各的，只能靠 AI 按意思对应&lt;br&gt;对应好之后，偏差由代码计算&lt;br&gt;&lt;br&gt;&lt;b&gt;难点：“实际工作量”用什么口径&lt;/b&gt;&lt;br&gt;故事点是相对值，排期工时不是实际工时；&lt;br&gt;没有实际工时系统，只能做项目级对比" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="c5b">
          <mxGeometry x="12" y="58" width="294" height="166" as="geometry" />
        </mxCell>
        <mxCell id="n-backtest" value="&lt;b&gt;回测：证明风险预警真的有效&lt;/b&gt;&lt;br&gt;ADO 的 WorkItemSnapshot 存了每个条目每天的状态。把已结束的项目倒回 8 周前，让 AI 基于当时的数据判断，再看后来有没有真的延期，就能说出“平均提前几周发现”。&lt;br&gt;前提：有人标注哪些历史项目延期或超支。" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1516" y="442" width="318" height="138" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E8E5A;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="620" width="1820" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c10-icon" value="" style="shape=image;html=1;image=img/lib/azure2/general/Toolbox.svg;aspect=fixed;imageAspect=0;" vertex="1" parent="c10">
          <mxGeometry x="12" y="12" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c10-title" value="&lt;b&gt;⑩ 自然语言提问（MCP）　贯穿全部三段，所有人都能用&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;例：“下个月结束、还没上 UAT 的固定总价项目有哪些？”　AI 只负责理解问题、调用工具、组织回答，数据都来自代码算好的表；天天要看的固定视图还是做成页面&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="c10">
          <mxGeometry x="56" y="8" width="1754" height="44" as="geometry" />
        </mxCell>
        <mxCell id="sec-base" value="" style="rounded=1;arcSize=2;html=1;fillColor=#F1F5F9;strokeColor=#334155;dashed=1;dashPattern=8 4;strokeWidth=1.5;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="30" y="704" width="1220" height="196" as="geometry" />
        </mxCell>
        <mxCell id="sec-base-title" value="&lt;b&gt;所有场景共用的底层能力&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#334155;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="46" y="714" width="1188" height="28" as="geometry" />
        </mxCell>
        <mxCell id="base0" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="46" y="746" width="385" height="64" as="geometry" />
        </mxCell>
        <mxCell id="base0-title" value="&lt;b&gt;证据包&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="base0">
          <mxGeometry x="12" y="8" width="363" height="24" as="geometry" />
        </mxCell>
        <mxCell id="base0-body" value="代码把数字和文字证据整理成统一格式，每条证据带 ID" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="base0">
          <mxGeometry x="12" y="38" width="361" height="20" as="geometry" />
        </mxCell>
        <mxCell id="base1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="447" y="746" width="385" height="64" as="geometry" />
        </mxCell>
        <mxCell id="base1-title" value="&lt;b&gt;固定格式输出，并核对引用&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="base1">
          <mxGeometry x="12" y="8" width="363" height="24" as="geometry" />
        </mxCell>
        <mxCell id="base1-body" value="引用的 ID 必须存在，数字必须和输入一致，否则作废" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="base1">
          <mxGeometry x="12" y="38" width="361" height="20" as="geometry" />
        </mxCell>
        <mxCell id="base2" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="848" y="746" width="385" height="64" as="geometry" />
        </mxCell>
        <mxCell id="base2-title" value="&lt;b&gt;建议 → 确认 → 记录&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="base2">
          <mxGeometry x="12" y="8" width="363" height="24" as="geometry" />
        </mxCell>
        <mxCell id="base2-body" value="复用工时预测的“接受 / 拒绝并填原因”；采纳率就是价值指标" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="base2">
          <mxGeometry x="12" y="38" width="361" height="20" as="geometry" />
        </mxCell>
        <mxCell id="base3" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="46" y="822" width="385" height="64" as="geometry" />
        </mxCell>
        <mxCell id="base3-title" value="&lt;b&gt;可见性&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="base3">
          <mxGeometry x="12" y="8" width="363" height="24" as="geometry" />
        </mxCell>
        <mxCell id="base3-body" value="沿用 UT Forecast 的规则，AI 的输出也不能绕过权限" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="base3">
          <mxGeometry x="12" y="38" width="361" height="20" as="geometry" />
        </mxCell>
        <mxCell id="base4" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="447" y="822" width="385" height="64" as="geometry" />
        </mxCell>
        <mxCell id="base4-title" value="&lt;b&gt;成本控制&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="base4">
          <mxGeometry x="12" y="8" width="363" height="24" as="geometry" />
        </mxCell>
        <mxCell id="base4-body" value="只分析本周有变化的项目，每周批量跑，输入相同时用缓存" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="base4">
          <mxGeometry x="12" y="38" width="361" height="20" as="geometry" />
        </mxCell>
        <mxCell id="base5" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="848" y="822" width="385" height="64" as="geometry" />
        </mxCell>
        <mxCell id="base5-title" value="&lt;b&gt;模型和数据边界&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="base5">
          <mxGeometry x="12" y="8" width="363" height="24" as="geometry" />
        </mxCell>
        <mxCell id="base5-body" value="用自己订阅里的 Azure OpenAI；客户文本能否发送，要和合规确认" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="base5">
          <mxGeometry x="12" y="38" width="361" height="20" as="geometry" />
        </mxCell>
        <mxCell id="sec-no" value="" style="rounded=1;arcSize=2;html=1;fillColor=#FEF3F2;strokeColor=#B42318;dashed=1;dashPattern=8 4;strokeWidth=1.5;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="1270" y="704" width="580" height="196" as="geometry" />
        </mxCell>
        <mxCell id="sec-no-title" value="&lt;b&gt;明确不做（为了 AI 而 AI）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#B42318;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1286" y="714" width="548" height="28" as="geometry" />
        </mxCell>
        <mxCell id="no-list" value="&lt;div style=&#39;line-height:1.55&#39;&gt;&lt;font color=&#39;#B42318&#39;&gt;✕&lt;/font&gt;　&lt;b&gt;让 AI 算完成度、速度、完成日期&lt;/b&gt;　&lt;font color=&#39;#6B7280&#39;&gt;代码算得准、结果稳定、不花钱&lt;/font&gt;&lt;br&gt;&lt;font color=&#39;#B42318&#39;&gt;✕&lt;/font&gt;　&lt;b&gt;让 AI 读源代码评估进度或质量&lt;/b&gt;　&lt;font color=&#39;#6B7280&#39;&gt;算不出总量，还有合规风险&lt;/font&gt;&lt;br&gt;&lt;font color=&#39;#B42318&#39;&gt;✕&lt;/font&gt;　&lt;b&gt;按提交次数或代码行数给个人打分&lt;/b&gt;　&lt;font color=&#39;#6B7280&#39;&gt;有误导性，属于员工监控&lt;/font&gt;&lt;br&gt;&lt;font color=&#39;#B42318&#39;&gt;✕&lt;/font&gt;　&lt;b&gt;训练模型预测完成日期&lt;/b&gt;　&lt;font color=&#39;#6B7280&#39;&gt;项目只有几十个，样本不够&lt;/font&gt;&lt;br&gt;&lt;font color=&#39;#B42318&#39;&gt;✕&lt;/font&gt;　&lt;b&gt;用评论做情绪分析，判断士气&lt;/b&gt;　&lt;font color=&#39;#6B7280&#39;&gt;准确率低，涉及隐私&lt;/font&gt;&lt;br&gt;&lt;font color=&#39;#B42318&#39;&gt;✕&lt;/font&gt;　&lt;b&gt;让 AI 直接改 ADO&lt;/b&gt;　&lt;font color=&#39;#6B7280&#39;&gt;写操作风险大，AI 只给建议&lt;/font&gt;&lt;br&gt;&lt;font color=&#39;#B42318&#39;&gt;✕&lt;/font&gt;　&lt;b&gt;用聊天框代替仪表盘&lt;/b&gt;　&lt;font color=&#39;#6B7280&#39;&gt;天天看的内容，打开页面更快&lt;/font&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1286" y="744" width="548" height="146" as="geometry" />
        </mxCell>
        <mxCell id="lg-box" value="" style="rounded=1;arcSize=12;html=1;fillColor=#FAFAFA;strokeColor=#CCCCCC;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="30" y="924" width="1387.36" height="44" as="geometry" />
        </mxCell>
        <mxCell id="lg-title" value="&lt;b&gt;图例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="46" y="924" width="50" height="44" as="geometry" />
        </mxCell>
        <mxCell id="lg-s0" value="" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#1D6FD8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="106" y="937.0" width="40" height="18" as="geometry" />
        </mxCell>
        <mxCell id="lg-t0" value="第一批：只要 ADO 数据，可以先做" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="154" y="924" width="202.79999999999998" height="44" as="geometry" />
        </mxCell>
        <mxCell id="lg-s1" value="" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#7A4FC4;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="380.79999999999995" y="937.0" width="40" height="18" as="geometry" />
        </mxCell>
        <mxCell id="lg-t1" value="第二批：要先有 SOW / DRM 数据" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="428.79999999999995" y="924" width="196.55999999999997" height="44" as="geometry" />
        </mxCell>
        <mxCell id="lg-s2" value="" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="649.3599999999999" y="937.0" width="40" height="18" as="geometry" />
        </mxCell>
        <mxCell id="lg-t2" value="第三批" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="697.3599999999999" y="924" width="48" height="44" as="geometry" />
        </mxCell>
        <mxCell id="lg-s3" value="" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="769.3599999999999" y="937.0" width="40" height="18" as="geometry" />
        </mxCell>
        <mxCell id="lg-t3" value="拒绝记录攒够之后" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#333333;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="817.3599999999999" y="924" width="108" height="44" as="geometry" />
        </mxCell>
        <mxCell id="lg-s4" value="" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#1E8E5A;strokeWidth=1.5;" vertex="1" parent="1">

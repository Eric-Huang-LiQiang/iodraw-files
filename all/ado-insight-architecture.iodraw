<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) ioDraw.com/3.6.1 Chrome/124.0.6367.49 Electron/30.0.0 Safari/537.36" version="24.7.17" pages="2">
  <diagram id="arch" name="总体架构">
    <mxGraphModel dx="2083" dy="1266" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1110" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;ADO 项目洞察 · 总体架构&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=24;fontColor=#1F2937;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="30" y="22" width="1400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="FACE（原 FrontierCUE）的新模块，沿用现有登录、PostgreSQL 和 MCP 服务　·　资源组 frontier-cue-dev（订阅 ISD-GCR-AIFirst）　·　&lt;b&gt;核心原则：数字由代码算，AI 只负责判断和写结论&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#6B7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="30" y="60" width="1820" height="22" as="geometry" />
        </mxCell>
        <mxCell id="sec-src" value="" style="rounded=1;arcSize=2;html=1;fillColor=#F5F6F8;strokeColor=#6B7280;dashed=1;dashPattern=8 4;strokeWidth=1.5;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="30" y="100" width="300" height="580" as="geometry" />
        </mxCell>
        <mxCell id="sec-src-title" value="&lt;b&gt;数据源&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#6B7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="46" y="110" width="268" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sec-src-sub" value="外部系统，只读" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#6B7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="46" y="136" width="268" height="18" as="geometry" />
        </mxCell>
        <mxCell id="ado" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="46" y="166" width="268" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ado-icon" value="" style="shape=image;html=1;image=img/lib/azure2/devops/Azure_DevOps.svg;aspect=fixed;imageAspect=0;" parent="ado" vertex="1">
          <mxGeometry x="12" y="12" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="ado-title" value="&lt;b&gt;Azure DevOps&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;多个组织 · 多个项目&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" parent="ado" vertex="1">
          <mxGeometry x="56" y="8" width="202" height="44" as="geometry" />
        </mxCell>
        <mxCell id="ado-body" value="Boards / Sprint：工作项、故事点、迭代&lt;br&gt;Repos / PR：提交统计、PR 讨论串&lt;br&gt;Pipelines / Test：运行结果、部署环境&lt;br&gt;Wiki：需求和设计文档（本质是 git）&lt;br&gt;评论：阻塞和客户依赖的线索&lt;br&gt;默认不拉源代码正文" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" parent="ado" vertex="1">
          <mxGeometry x="12" y="58" width="244" height="96" as="geometry" />
        </mxCell>
        <mxCell id="ado-signals" value="&lt;div style=&#39;line-height:1.55&#39;&gt;&lt;b&gt;从 ADO 能看出什么&lt;/b&gt;&lt;br&gt;范围与进度 · 节奏 · 流动 · 质量 · 交付 · 文档&lt;br&gt;&lt;br&gt;&lt;b&gt;信号组合 → 项目阶段&lt;/b&gt;&lt;br&gt;启动：Feature 陆续创建，需求页增加&lt;br&gt;开发：提交和 PR 活跃，主要部署到 dev&lt;br&gt;测试/UAT：Bug 变多，开始部署到 UAT&lt;br&gt;上线：出现部署到生产的记录&lt;br&gt;维护：提交减少，新增以 Bug 为主&lt;br&gt;停滞：所有来源连续 N 天没动静&lt;br&gt;&lt;br&gt;&lt;font color=&#39;#6B7280&#39;&gt;很多项目 ADO 维护得不好，所以先打&lt;br&gt;数据质量分，太差就显示“无法判断”&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#CCCCCC;fontSize=11;fontColor=#333333;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="46" y="350" width="268" height="304" as="geometry" />
        </mxCell>
        <mxCell id="sec-presale" value="" style="rounded=1;arcSize=2;html=1;fillColor=#F5F6F8;strokeColor=#6B7280;dashed=1;dashPattern=8 4;strokeWidth=1.5;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="30" y="730" width="300" height="250" as="geometry" />
        </mxCell>
        <mxCell id="sec-presale-title" value="&lt;b&gt;售前资料&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#6B7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="46" y="740" width="268" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sec-presale-sub" value="第二批才接入" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#6B7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="46" y="766" width="268" height="18" as="geometry" />
        </mxCell>
        <mxCell id="presale" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;dashPattern=6 4;" parent="1" vertex="1">
          <mxGeometry x="46" y="800" width="268" height="150" as="geometry" />
        </mxCell>
        <mxCell id="presale-icon" value="" style="shape=image;html=1;image=img/lib/azure2/general/Files.svg;aspect=fixed;imageAspect=0;" parent="presale" vertex="1">
          <mxGeometry x="12" y="12" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="presale-title" value="&lt;b&gt;SOW 与 DRM 估算&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;还没进系统&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" parent="presale" vertex="1">
          <mxGeometry x="56" y="8" width="202" height="44" as="geometry" />
        </mxCell>
        <mxCell id="presale-body" value="SOW：合同范围条款，放在哪里待确认&lt;br&gt;DRM：售前估算，目前只存在浏览器里，&lt;br&gt;要先存进数据库" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" parent="presale" vertex="1">
          <mxGeometry x="12" y="58" width="244" height="86" as="geometry" />
        </mxCell>
        <mxCell id="sec-ingest" value="" style="rounded=1;arcSize=2;html=1;fillColor=#EDF4FD;strokeColor=#1D6FD8;dashed=1;dashPattern=8 4;strokeWidth=1.5;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="380" y="100" width="360" height="580" as="geometry" />
        </mxCell>
        <mxCell id="sec-ingest-title" value="&lt;b&gt;身份与采集&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#1D6FD8;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="396" y="110" width="328" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sec-ingest-sub" value="不存任何密钥" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=12;fontColor=#6B7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="396" y="136" width="328" height="18" as="geometry" />
        </mxCell>
        <mxCell id="job" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6FD8;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="396" y="166" width="328" height="180" as="geometry" />
        </mxCell>
        <mxCell id="job-icon" value="" style="shape=image;html=1;image=img/lib/azure2/other/Worker_Container_App.svg;aspect=fixed;imageAspect=0;" parent="job" vertex="1">
          <mxGeometry x="12" y="12" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="job-title" value="&lt;b&gt;采集任务&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;Container Apps Job · 定时触发&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" parent="job" vertex="1">
          <mxGeometry x="56" y="8" width="262" height="44" as="geometry" />
        </mxCell>
        <mxCell id="job-body" value="每天 1~2 次；不放进网站进程（B1、单实例）&lt;br&gt;Analytics OData：WorkItems、WorkItemSnapshot&lt;br&gt;REST：提交、PR、wiki、评论、构建日志&lt;br&gt;增量起点记在 source_sync_state&lt;br&gt;限流 200 TSTU / 5 分钟，遵守 Retry-After&lt;br&gt;（TSTU 是 ADO 计量负载的单位）" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" parent="job" vertex="1">
          <mxGeometry x="12" y="58" width="304" height="116" as="geometry" />
        </mxCell>
        <mxCell id="mi" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6FD8;strokeWidth=1.5;" parent="1" vertex="1">
          <mxGeometry x="396" y="400" width="328" height="116" as="geometry" />
        </mxCell>
        <mxCell id="mi-icon" value="" style="shape=image;html=1;image=img/lib/azure2/identity/Managed_Identities.svg;aspect=fixed;imageAspect=0;" parent="mi" vertex="1">
          <mxGeometry x="12" y="12" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="mi-title" value="&lt;b&gt;用户分配托管标识&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;id-frontier-cue-ado-reader&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" parent="mi" vertex="1">
          <mxGeometry x="56" y="8" width="262" height="44" as="geometry" />
        </mxCell>
        <mxCell id="mi-body" value="ADO 管理员在每个组织里显式添加&lt;br&gt;访问级别 Basic，加入项目 Readers 组&lt;br&gt;换令牌的资源 ID 499b84ac-…-6975798" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" parent="mi" vertex="1">
          <mxGeometry x="12" y="58" width="304" height="52" as="geometry" />
        </mxCell>
        <mxCell id="fic" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6FD8;strokeWidth=1.5;dashed=1;dashPattern=6 4;" parent="1" vertex="1">
          <mxGeometry x="396" y="546" width="328" height="108" as="geometry" />
        </mxCell>
        <mxCell id="fic-icon" value="" style="shape=image;html=1;image=img/lib/azure2/identity/App_Registrations.svg;aspect=fixed;imageAspect=0;" parent="fic" vertex="1">
          <mxGeometry x="12" y="12" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="fic-title" value="&lt;b&gt;跨租户时：多租户应用&lt;/b&gt;&lt;br&gt;&lt;font color=&#39;#666666&#39; style=&#39;font-size:11px&#39;&gt;只有客户租户的 ADO 才需要&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=13;fontColor=#333333;align=left;verticalAlign=middle;" parent="fic" vertex="1">
          <mxGeometry x="56" y="8" width="262" height="44" as="geometry" />
        </mxCell>
        <mxCell id="fic-body" value="联合身份凭据：用托管标识的令牌换应用令牌&lt;br&gt;添加时用 Enterprise applications 的对象 ID" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" parent="fic" vertex="1">
          <mxGeometry x="12" y="58" width="304" height="44" as="geometry" />
        </mxCell>
        <mxCell id="sec-ai" value="" style="rounded=1;arcSize=2;html=1;fillColor=#F3EEFB;strokeColor=#7A4FC4;dashed=1;dashPattern=8 4;strokeWidth=1.5;" parent="1" vertex="1" connectable="0">
          <mxGeometry x="790" y="100" width="420" height="580" as="geometry" />
        </mxCell>
        <mxCell id="sec-ai-title" value="&lt;b&gt;分析流程&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=15;fontColor=#7A4FC4;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="806" y="110" width="388" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sec-ai-sub" value="每周批量跑；自己写的运行器按环节清单执行&lt;br&gt;每个环节的结果都存库，可以单独重跑、复用上次结果" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#6B7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="806" y="134" width="388" height="32" as="geometry" />
        </mxCell>

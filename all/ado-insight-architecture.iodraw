        <mxCell id="st-llm-body" value="按固定格式输出 JSON，数字只能照抄" style="text;html=1;whiteSpace=wrap;spacing=0;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" parent="st-llm" vertex="1">

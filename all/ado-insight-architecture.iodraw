        <mxCell id="st-pack" value="&lt;b&gt;pack&lt;/b&gt;　&lt;font color=&#39;#555555&#39;&gt;整理证据包，每条证据带 ID&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A4FC4;strokeWidth=1.5;fontColor=#1F2937;align=left;verticalAlign=middle;spacingRight=6;fontSize=12;spacingLeft=12;" parent="1" vertex="1">
          <mxGeometry x="862" y="408" width="300" height="40" as="geometry" />
